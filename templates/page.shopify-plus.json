          "type": "faq_item",
          "settings": {
            "question": "How long does a Shopify Plus migration take?",
            "answer": "<p>Most projects are completed in <strong>4–6 weeks</strong>, depending on the size of your store and platform complexity. We’ll give you a clear timeline before we begin.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_AdgFRX": {
          "type": "faq_item",
          "settings": {
            "question": "Do I lose my existing SEO or Google rankings during migration?",
            "answer": "<p>No. We preserve your SEO structure by redirecting old URLs to new ones using Shopify best practices. We also transfer all meta titles, descriptions, and alt text.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_E6VP9h": {
          "type": "faq_item",
          "settings": {
            "question": "Can you migrate from Salesforce Commerce Cloud to Shopify Plus?",
            "answer": "<p>Yes. We’ve handled complex migrations from Salesforce, including product variants, customer data, and legacy integrations.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_QBr3LB": {
          "type": "faq_item",
          "settings": {
            "question": "Do you handle Shopify Plus internationalisation?",
            "answer": "<p>Absolutely. If you’re planning a multi-region store (currencies, languages, subdomains), we can configure Shopify Markets or create custom setups depending on your growth plans.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_Ti7hUf": {
          "type": "faq_item",
          "settings": {
            "question": "Can you migrate apps and third-party tools?",
            "answer": "<p>Yes. We’ll recommend Shopify-native apps to replace bloated third-party tools where possible, improving site speed and admin flow.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_tJxanT": {
          "type": "faq_item",
          "settings": {
            "question": "Do you work with agencies or in-house marketing teams?",
            "answer": "<p>Yes. We can white-label or work collaboratively with your internal devs or marketers. You’ll get a dedicated migration lead to keep things smooth.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_3rBLY7": {
          "type": "faq_item",
          "settings": {
            "question": "What if I have a massive product catalogue or custom fields?",
            "answer": "<p>We handle <strong>bulk product migrations</strong> via CSV, JSON, or API. Custom fields and metafields are rebuilt properly in Shopify Plus. We don’t cut corners.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_niNjJM": {
          "type": "faq_item",
          "settings": {
            "question": "Do you offer post-launch support or training?",
            "answer": "<p>Yes. Every Shopify Plus migration comes with <strong>90 days of priority support</strong>, admin training, and a 1-year theme warranty.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_PYrdjE": {
          "type": "faq_item",
          "settings": {
            "question": "How do you compare to other Shopify Plus migration agencies?",
            "answer": "<p>Many agencies start at $25K–$30K+. Our pricing starts from <strong>A$15,500</strong>, and we build <strong>100% in-house</strong> with faster delivery and local support.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_pGAqqF": {
          "type": "faq_item",
          "settings": {
            "question": "Can you redesign our site as part of the migration?",
            "answer": "<p>Yes. We’ll rebuild your frontend for Shopify Plus with speed, UX, and conversions in mind - not just replicate your old store.</p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        }
