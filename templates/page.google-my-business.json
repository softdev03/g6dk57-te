          "disabled": true,
          "settings": {
            "image": "shopify://shop_images/general-tradies-websites.webp",
            "detail_info_heading": "All Other Tradies",
            "detail_info_text": "<p>No matter your trade, we build websites that work for you. From builders and tilers to landscapers and painters, we design sites that show off your skills, bring in more work, and make booking you a no-brainer.</p><p></p><p></p>",
            "icon": "shopify://shop_images/yellow-arrow.svg",
