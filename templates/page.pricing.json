    "marketing_focus_PdGT6c": {
      "type": "marketing-focus",
      "name": "Service Marketing Focus Section",
      "settings": {
        "key": "2",
        "logo_image": "shopify://shop_images/04.jpg",
        "headline": "Ready to Build a Website That Actually Brings in Leads?",
        "sub_text": "Your next customer is already searching for you.\nLet’s build a site that helps them find you — and makes them want to book, call, or buy.",
        "button_text": "Request a Free Quote",
        "button_link": "shopify://pages/contact",
