    "faq_cYAhKJ": {
      "type": "faq",
      "blocks": {
        "faq_item_rrnAHz": {
          "type": "faq_item",
          "settings": {
            "question": "Do Instagram ads actually work for local businesses or just big brands?",
            "answer": "<p>Absolutely. With smart targeting and the right creative, we get local businesses in front of the people most likely to book or buy. Whether you’re a tradie or a boutique, it’s all about the message and the audience.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_AdgFRX": {
          "type": "faq_item",
          "settings": {
            "question": "How much should I spend on Instagram ads to see real results?",
            "answer": "<p>There’s no one-size-fits-all, but most of our clients start seeing solid traction with as little as $20–$50/day. We’ll help you scale smart and track every dollar spent.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_E6VP9h": {
          "type": "faq_item",
          "settings": {
            "question": "What kind of results can I expect from Instagram ads?",
            "answer": "<p>Leads, sales, DMs — whatever your business needs. We focus on outcomes, not just reach or likes. Our campaigns are geared toward growth, not vanity metrics.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_akFz96": {
          "type": "faq_item",
          "settings": {
            "question": "Can I run Instagram ads without a big following?",
            "answer": "<p>Yep. Instagram ads don’t rely on how many followers you have. We build your reach through paid strategy — not popularity contests.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_jdQR46": {
          "type": "faq_item",
          "settings": {
            "question": "How do you target the right people on Instagram?",
            "answer": "<p>We use location targeting, interest-based data, behavioural signals, and lookalike audiences to hone in on the users most likely to convert. No guesswork — just strategy.</p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_nyFTVE": {
          "type": "faq_item",
          "settings": {
            "question": "Will I need to make content or do you do it all?",
            "answer": "<p>We can handle everything — from ad copy to creative. If you’ve got great visuals, we’ll use them. If not, we’ll help create scroll-stopping content that does the job.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_XN9Db9": {
          "type": "faq_item",
          "settings": {
            "question": "How long until I see results from Instagram ads?",
            "answer": "<p>Some clients see leads in the first 48 hours. Others take a few weeks to dial in. It depends on your industry, offer, and spend — but we move fast and keep you updated.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_C7MHEi": {
          "type": "faq_item",
          "settings": {
            "question": "What types of businesses see the best results on Instagram?",
            "answer": "<p>Visual, lifestyle-driven brands like fashion, beauty, pets, food, fitness — and trades who show off their work. If your service or product can be shown off well, we’ll make it shine.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_Htp8HR": {
          "type": "faq_item",
          "settings": {
            "question": "Will I get reporting and updates on my Instagram ads?",
            "answer": "<p>Every step of the way. We give you easy-to-read reports, insights into what’s working, and a direct line to our team for any questions or pivots.</p><p></p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        },
        "faq_item_Fb4Rdq": {
          "type": "faq_item",
          "settings": {
            "question": "What makes your Instagram ads different from boosting posts?",
            "answer": "<p>Boosting is just basic exposure. We run structured campaigns through Meta Ads Manager with goal-focused targeting, A/B testing, and conversion tracking. It’s not just a boost — it’s a proper strategy.</p>",
            "icon": "shopify://shop_images/plus_1.png"
          }
        }
