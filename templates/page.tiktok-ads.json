          "type": "trust_item",
          "settings": {
            "heading": "TREND-SMART STRATEGY",
            "main_text": "<p>We don’t chase trends — we use them to your advantage. Our team knows how to frame your offer in a way that gets attention and turns traffic into action. Strategy first, always.</p><p></p>",
            "button_text": "",
            "additional_text": "",
            "accordion_image": "shopify://shop_images/yellow-arrow.svg"
          }
        },
        "trust_item_YFytD9": {
          "type": "trust_item",
          "settings": {
            "heading": "BUILT FOR SHOPIFY & TRADIES",
            "main_text": "<p>From local roofers to fast-growing ecomm stores, we’ve run TikTok campaigns across the board. We know what works for your audience and how to keep your cost-per-click tight.</p><h3></h3><p></p>",
            "button_text": "",
            "additional_text": "",
            "accordion_image": "shopify://shop_images/yellow-arrow.svg"
          }
        },
        "trust_item_JfVUzV": {
