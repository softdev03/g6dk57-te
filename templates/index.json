    "advertise_FfNzr9": {
      "type": "advertise",
      "settings": {
        "main_image": "shopify://shop_images/a7663a1627dc732a8505611a4a34da37.webp",
        "secondary_image": "shopify://shop_images/grow-your-brand_a831e197-6984-4fb5-af1a-f72723d0f61b.svg",
