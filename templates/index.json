    "benefits_section_NjXzKr": {
      "type": "benefits-section",
      "blocks": {
        "benefit_Y46pga": {
          "type": "benefit",
          "settings": {
            "benefit_title": "Reach a Bigger Audience",
            "benefit_description": "Relying on referrals or foot traffic only takes you so far. A strong online presence helps you tap into wider markets—locally and nationwide. Whether you're a plumber or a product brand, your next customer is already searching for what you do. We help you get in front of them at the right time. You’ll start showing up where it matters: Google, Facebook, Instagram, and more. The more visibility you have, the more chances you get to win business.",
            "benefit_icon": "shopify://shop_images/check-blue-white.svg"
          }
        },
        "benefit_AW7kGg": {
          "type": "benefit",
          "settings": {
            "benefit_title": "Build Real Credibility",
            "benefit_description": "When customers see a modern, fast website and consistent branding, trust skyrockets. Whether you're offering skin treatments or solar installs, people want to know you're legit before they click or call. A professional online presence does that without you having to say a word. We'll help you build authority with sharp design, clean copy, and real testimonials. Add SEO on top, and you're now seen as a trusted name in your space. People buy from businesses they believe in — we help make that belief instant.",
            "benefit_icon": "shopify://shop_images/check-blue-white.svg"
          }
        },
        "benefit_FPeAQa": {
          "type": "benefit",
          "settings": {
            "benefit_title": "Stand Out From the Crowd",
            "benefit_description": "There’s no shortage of competition online. That’s why we focus on making your business the obvious choice. Our team helps you uncover your unique edge — then we bake it into your website, ads, and overall digital strategy. Whether you're up against big-box retailers or other tradies in your suburb, we make you the one that gets remembered. It's not about shouting louder — it's about showing up smarter. Let’s help you win the clicks that count.",
            "benefit_icon": "shopify://shop_images/check-blue-white.svg"
          }
        },
        "benefit_wNGBXq": {
          "type": "benefit",
          "settings": {
            "benefit_title": "Attract Better Clients and Customers",
            "benefit_description": "Not all clicks are created equal. We don’t just drive traffic — we drive qualified traffic that’s ready to convert. We’ll help you reach the people who value what you offer and are happy to pay for it. With targeted ads, SEO, and conversion-focused design, you’ll attract customers who stick around, not just window shop. It’s time to stop chasing the wrong crowd. We’ll get the right people through your virtual door.",
            "benefit_icon": "shopify://shop_images/check-blue-white.svg"
          }
        }
      },
      "block_order": [
        "benefit_Y46pga",
