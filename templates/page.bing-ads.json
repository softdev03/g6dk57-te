    "trust_Q37M3R": {
      "type": "trust",
      "blocks": {
        "trust_item_KtaqTQ": {
          "type": "trust_item",
          "settings": {
            "heading": "Less Competition, More Visibility",
            "main_text": "<p><strong>Why Bing Ads Work When Google’s Crowded</strong><br/><br/>Google Ads might get all the attention, but Bing captures a chunk of high-intent users especially desktop and Microsoft users. With fewer advertisers competing, your ad budget stretches further and gets noticed by people ready to click.</p><p></p>",
            "button_text": "",
            "additional_text": "",
            "accordion_image": "shopify://shop_images/yellow-arrow.svg"
          }
        },
        "trust_item_YFytD9": {
          "type": "trust_item",
          "settings": {
            "heading": "Great for eComm & Lead Gen",
            "main_text": "<p><strong>Whether You Sell or Service, Bing Delivers</strong><br/><br/>Bing Ads are a hidden weapon for Shopify merchants looking for ROI and trade businesses wanting serious enquiries. Our data-led approach makes sure your listings show up in the right searches with the right message.</p><p></p>",
            "button_text": "",
            "additional_text": "",
            "accordion_image": "shopify://shop_images/yellow-arrow.svg"
          }
        },
        "trust_item_JfVUzV": {
          "type": "trust_item",
          "settings": {
            "heading": "Microsoft Ecosystem Advantage",
            "main_text": "<p><strong>Reach People Where Google Can’t</strong><br/><br/>Bing powers search on Microsoft Edge, Windows 11, and even some Android devices. If you’re not on Bing, you’re invisible to a big part of the market. We’ll make sure you’re not missing out.</p><p></p>",
            "button_text": "",
            "additional_text": "",
            "accordion_image": "shopify://shop_images/yellow-arrow.svg"
          }
        }
      },
      "block_order": [
        "trust_item_KtaqTQ",
        "trust_item_YFytD9",
        "trust_item_JfVUzV"
      ],
      "settings": {
        "hero_section": false,
        "heading": "Why Use An Agency for Bing Ads?",
        "text": "<p><strong>Proven campaigns. Local insight. Smarter spend.</strong></p><p>We’ve built high-performing Bing Ads campaigns for both eCommerce brands and lead gen clients who were tired of wasting budget on noisy platforms. Bing might fly under the radar but that’s exactly what makes it powerful.</p><p>At An Agency, we tap into search intent that’s often ignored. We know how to position your Shopify store or service business in front of the right audience without paying premium prices to be seen.</p>",
        "trust_image": "shopify://shop_images/Artboard_13.png",
        "desktop_padding_top": 60,
        "desktop_padding_bottom": 60,
        "mobile_padding_top": 40,
        "mobile_padding_bottom": 40
      }
