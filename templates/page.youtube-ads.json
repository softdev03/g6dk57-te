          "type": "faq_item",
          "settings": {
            "question": "Can I control where my ads appear on YouTube?",
            "answer": "<p>Yes, you can choose placements and exclude certain channels or content types to ensure your ads appear in suitable contexts. </p>",
            "icon": "shopify://shop_images/yellow-arrow.svg"
          }
