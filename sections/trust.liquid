{{ 'trust.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    #shopfy-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="shopify-section-trust page-width">
  {%- if section.settings.heading != blank -%}
    {%- if section.settings.hero_section -%}
      <h1 class="heading m-0">{{ section.settings.heading }}</h1>
    {%- else -%}
      <h2 class="heading m-0">{{ section.settings.heading }}</h2>
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.text != blank -%}
    <div class="text">{{ section.settings.text }}</div>
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="trust-items-wrapper">
      {%- for block in section.blocks -%}
        <div class="trust-item">
          <div class="item-main-content">
            {%- if block.settings.heading != blank -%}
              <h2 class="item-heading m-0">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.main_text != blank -%}
              <div class="main-text">{{ block.settings.main_text }}</div>
            {%- endif -%}
          </div>
          {%- if block.settings.additional_text != blank and block.settings.button_text != blank -%}
            <div class="accordion" container="#shopify-section-{{ section.id }}">
              <div class="accordion-heading">
                {{ block.settings.button_text }}
                {%- if block.settings.accordion_image != blank -%}
                  <div class="icon">
                    <img src="{{ block.settings.accordion_image |  img_url: '20x' }}" alt="" width="15px" height="15px">
                  </div>
                {%- endif -%}
              </div>
              <div class="accordion-content">{{ block.settings.additional_text }}</div>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if section.settings.trust_image != blank -%}
    <div class="trust-image">
      <img src="{{ section.settings.trust_image |  img_url: 'master' }}" alt="" width="1440px" height="auto">
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Trust",
  "tag": "section",
  "class": "shopify-section--trust",
  "settings": [
    {
      "type": "checkbox",
      "id": "hero_section",
      "label": "Hero Section",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "trust_image",
      "label": "Trust Image"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "main_text",
          "label": "Main Text"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        },
        {
          "type": "richtext",
          "id": "additional_text",
          "label": "Additional Text"
        },
        {
          "type": "image_picker",
          "id": "accordion_image",
          "label": "Accordion Image"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust",
      "settings": {}
    }
  ]
}
{% endschema %}
