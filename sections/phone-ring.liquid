{{ 'phone-ring.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="shopify-section-phone-ring page-width {% if section.settings.image_right == true %} image-right {% endif %}">
  <div class="text-content align-{{ section.settings.text_align }}">
    {%- if section.settings.heading_1 != blank or section.settings.heading_2 != blank -%}
      <div class="heading-wrapper">
      {%- if section.settings.heading_1 != blank -%}
        <h1 class="heading first m-0">{{ section.settings.heading_1 }}</h1>
      {%- endif -%}
      {%- if section.settings.heading_2 != blank -%}
        <h1 class="heading second m-0">{{ section.settings.heading_2 }}</h1>
      {%- endif -%}
    </div>
    {%- endif -%}
    {%- if section.settings.sub_heading != blank -%}
      <h2 class="sub-heading m-0">{{ section.settings.sub_heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="text m-0">{{ section.settings.text }}</p>
    {%- endif -%}
    <div class="button-list">
      {%- if section.settings.phone_button_text != blank and section.settings.phone_number != blank -%}
        <a href="tel:{{ section.settings.phone_number }}" class="phone-link">
          {{- section.settings.phone_button_text -}}
        </a>
      {%- endif -%}
      {%- if section.settings.enquire_button_link != blank and section.settings.enquire_button_text != blank -%}
        <a href="{{ section.settings.enquire_button_link }}" class="enquire-button">
          {{- section.settings.enquire_button_text -}}
        </a>
      {%- endif -%}
    </div>
  </div>
  {%- if section.settings.image != blank -%}
    <div class="image lh-0">
      <img class="desktop" src="{{ section.settings.image |  img_url: '800x' }}" alt="" width="800px" height="auto">
      <img class="mobile" src="{{ section.settings.image |  img_url: '800x' }}" alt="" width="800px" height="auto">
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Phone Ringing",
  "tag": "section",
  "class": "shopify-section--phone-ring",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading 1"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading 2"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "phone_button_text",
      "label": "Phone Button Text"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number"
    },
    {
      "type": "text",
      "id": "enquire_button_text",
      "label": "Enquire Button Text"
    },
    {
      "type": "url",
      "id": "enquire_button_link",
      "label": "Enquire Button Link"
    },
    {
      "type": "checkbox",
      "id": "image_right",
      "label": "Image Right",
      "default": true
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Phone Ringing",
      "settings": {}
    }
  ]
}
{% endschema %}
