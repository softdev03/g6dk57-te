{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="shopify-section-text-list page-width">
  {%- if section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      <div class="text-item text" id="text-{{ block.id }}">{{ block.settings.text }}</div>
      {%- style -%}
        @media screen and (min-width: 750px) {
          #text-{{ block.id }} {
            font-size: {{ block.settings.desktop_font_size }}px;
            font-weight: {{ block.settings.desktop_font_weight }};
            text-align: {{ block.settings.desktop_align }};
            text-transform: {{ block.settings.desktop_text_transform }};
            margin-bottom: {{ block.settings.desktop_margin }}px;
            max-width: {{ block.settings.desktop_max_width }}px;
            line-height: {{ block.settings.desktop_line_height }};
          letter-spacing: {{ block.settings.mobile_letter_spacing }}px;
            {%- case block.settings.desktop_align -%}
              {%- when 'center' -%}
                margin-left: auto;
                margin-right: auto;
              {%- when 'auto' -%}
                margin-left: auto;
              {%- else -%}
                margin-right: auto;
            {%- endcase -%}
          }
        }
        @media screen and (max-width: 749px) {
          #text-{{ block.id }} {
            font-size: {{ block.settings.mobile_font_size }}px;
            font-weight: {{ block.settings.mobile_font_weight }};
            text-align: {{ block.settings.mobile_align }};
            text-transform: {{ block.settings.mobile_text_transform }};
            margin-bottom: {{ block.settings.mobile_margin }}px;
            max-width: {{ block.settings.mobile_max_width }}px;
            line-height: {{ block.settings.mobile_line_height }};
          letter-spacing: {{ block.settings.mobile_letter_spacing }}px;
            {%- case block.settings.mobile_align -%}
              {%- when 'center' -%}
                margin-left: auto;
                margin-right: auto;
              {%- when 'auto' -%}
                margin-left: auto;
              {%- else -%}
                margin-right: auto;
            {%- endcase -%}
          }
        }
      {%- endstyle -%}
    {%- endfor -%}
  {%- endif -%}
</div>
