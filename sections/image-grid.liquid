{{ 'image-grid.css' | asset_url | stylesheet_tag }}
{%- style -%}
   #shopify-section-{{ section.id }} {
     padding-top: {{ section.settings.desktop_padding_top }}px;
     padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
   }
  #shopify-section-{{ section.id }} .heading {
    color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .heading span {
    color: {{ section.settings.secondary_heading_color }};
  }
  #shopify-section-{{ section.id }} .description {
    color: {{ section.settings.description_color }};
    max-width: {{ section.settings.text_max_width }}px;
  }
  #shopify-section-{{ section.id }} .link {
    border-radius: {{ section.settings.link_btn_border_radius }}px;
    background-color: {{ section.settings.link_btn_bg_color }};
    color: {{ section.settings.link_btn_text_color }};
  }
  #shopify-section-{{ section.id }} .link:hover {
    background-color: {{ section.settings.link_btn_bg_color_hover }};
    color: {{ section.settings.link_btn_text_color_hover }};
  }
  {%- assign breakpoints = section.blocks |  where: 'type', 'breakpoint' |  map: 'settings' |  reverse -%}
  {%- for breakpoint in breakpoints -%}
    {% if breakpoint.max_width > 0 %}@media screen and (max-width: {{ breakpoint.max_width }}px) { {% endif %}
      #shopify-section-{{ section.id }} .image-grid {
        row-gap: {{ breakpoint.row_gap }}px;
        column-gap: {{ breakpoint.col_gap }}px;
      }
      #shopify-section-{{ section.id }} .image {
        {%- assign gapCount = breakpoint.item_count |  minus: 1 -%}
        {%- assign gapWidth = gapCount |  times: breakpoint.col_gap -%}
        width: calc((100% - {{ gapWidth }}px) / {{ breakpoint.item_count }});
      }
    {% if breakpoint.max_width > 0 %} } {% endif %}
  {%- endfor -%}
   @media screen and (max-width: 749px) {
       #shopify-section-{{ section.id }} {
         padding-top: {{ section.settings.mobile_padding_top }}px;
         padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
       }
   }
{%- endstyle -%}
<div class="shopify-section-image-grid page-width">
  {%- if section.settings.heading != blank -%}
  {%- if section.settings.hero_section -%}
    <h1 class="heading">
      {%- if section.settings.secondary_heading != blank -%}
        {%- assign secondary = '<span>' | append: section.settings.secondary_heading | append: '</span>' -%}
        {{ section.settings.heading | replace: '[]', secondary }}
      {%- endif -%}      
    </h1>
  {%- else -%}
    <h2 class="heading">
      {%- if section.settings.secondary_heading != blank -%}
        {%- assign secondary = '<span>' | append: section.settings.secondary_heading | append: '</span>' -%}
        {{ section.settings.heading | replace: '[]', secondary }}
      {%- endif -%}      
    </h2>
  {%- endif -%}
  {%- endif -%}
  {%- if section.settings.description != blank -%}
    <p class="description">{{ section.settings.description }}</p>
  {%- endif -%}
  {%- assign imageBlocks = section.blocks | where: 'type', 'image_item' -%}
  <div class="image-grid">
    {%- for imageBlock in imageBlocks -%}
      {%- if imageBlock.settings.image != blank -%}
        {%- if imageBlock.settings.image_link != blank -%}
          <a href="{{ imageBlock.settings.image_link }}" class="image">
            <img src="{{ imageBlock.settings.image |  img_url: '1000x' }}" alt="" width="1000px" height="auto">
          </a>
        {%- else -%}
          <div class="image">
            <img src="{{ imageBlock.settings.image |  img_url: '1000x' }}" alt="" width="1000px" height="auto">
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
  {%- if section.settings.link != blank and section.settings.link_btn_text != blank -%}
    <a href="{{ section.settings.link }}" class="link">
      {{ section.settings.link_btn_text }}
      {%- if section.settings.link_btn_icon != blank -%}
        <img src="{{ section.settings.link_btn_icon |  img_url: '20x' }}" alt="" width="20px" height="auto">
        {%- if section.settings.link_btn_icon_hover != blank -%}
          <img src="{{ section.settings.link_btn_icon_hover |  img_url: '20x' }}" alt="" width="20px" height="auto">
        {%- endif -%}
      {%- endif -%}
    </a>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Image Grid",
  "tag": "section",
  "class": "shopify-section--image-grid",
  "settings": [
  {
      "type": "checkbox",
      "id": "hero_section",
      "label": "Hero Section",
      "default": false
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "secondary_heading",
      "label": "Secondary Heading"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "secondary_heading_color",
      "label": "Secondary Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#000000"
    },
    {
      "type": "number",
      "id": "text_max_width",
      "label": "Text Max Width",
      "default": 1440
    },
    {
      "type": "header",
      "content": "Link Button Settings"
    },
    {
      "type": "text",
      "id": "link_btn_text",
      "label": "Link Button Text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color",
      "id": "link_btn_bg_color",
      "label": "Link Button Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_btn_text_color",
      "label": "Link Button Text Color",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "link_btn_bg_color_hover",
      "label": "Link Button Background Color when Hover",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "link_btn_text_color_hover",
      "label": "Link Button Text Color when Hover",
      "default": "#fff"
    },
    {
      "type": "range",
      "id": "link_btn_border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Link Button Border Radius",
      "default": 0
    },
    {
      "type": "image_picker",
      "id": "link_btn_icon",
      "label": "Link Button Icon"
    },
    {
      "type": "image_picker",
      "id": "link_btn_icon_hover",
      "label": "Link Button Icon when Hover"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "image_item",
      "name": "Image Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "image_link",
          "label": "Image Link"
        }
      ]
    },
    {
      "type": "breakpoint",
      "name": "Breakpoint",
      "settings": [
        {
          "type": "number",
          "id": "max_width",
          "label": "Max Width"
        },
        {
          "type": "range",
          "id": "item_count",
          "min": 2,
          "max": 30,
          "step": 1,
          "label": "Item Count",
          "default": 2
        },
        {
          "type": "range",
          "id": "col_gap",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Column Gap",
          "default": 0
        },
        {
          "type": "range",
          "id": "row_gap",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Row Gap",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Grid",
      "settings": {}
    }
  ]
}
{% endschema %}
