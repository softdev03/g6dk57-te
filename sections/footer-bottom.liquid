
{% schema %}
{
  "name": "Footer Bottom",
  "settings": [   
    {
      "type": "text",
      "id": "footer_bottom_text",
      "label": "Footer Bottom Text"
    }   
  ],
  "blocks": [
    {
      "type": "link_item",
      "name": "Link Item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Bottom",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

{% style %}
#shopify-section-{{ section.id }} {
  background-color:black;
}
.footer-bottom{
  text-align:center;
  align-items:center;
  padding:35px 0px;
  font-size:12px;
}
  .footer-bottom p{
    color:white;
    margin:0;
  }
  .footer-bottom a {
    color: inherit;
    text-decoration: none;
  }
{% endstyle %}
<section class="bottom-section page-width">
  <div class="footer-bottom">
    {%- assign text = section.settings.footer_bottom_text -%}
    {%- for block in section.blocks -%}
      {%- assign link_tag = block.settings.label |  link_to: block.settings.link -%}
      {%- assign text = text | replace_first : block.settings.label ,link_tag  -%}
    {%- endfor -%}
    <p>{{ text }}</p>
  </div>
  
</section>