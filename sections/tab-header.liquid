{{ 'tab-header.css' |  asset_url |  stylesheet_tag }}
{%- style -%}
	#shopify-section-{{ section.id }} {
		padding-top: {{ section.settings.desktop_padding_top }}px;
		padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
		background-color: {{ section.settings.bg_color }};
	}
	#shopify-section-{{ section.id }} .tab-header {
   	background-color: {{ section.settings.tab_bg_color |  default : 'transparent' }};
   	color: {{ section.settings.tab_text_color |  default : 'transparent' }};
   }
   #shopify-section-{{ section.id }} .tab-header-item.selected {
   	color: {{ section.settings.tab_text_color_selected |  default : 'transparent' }};
   }
   #shopify-section-{{ section.id }} .tab-thumb {
   	background-color: {{ section.settings.tab_bg_color_selected |  default : 'transparent' }};
  }
	@media screen and (max-width: 749px) {
		#shopify-section-{{ section.id }} {
			padding-top: {{ section.settings.mobile_padding_top }}px;
			padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
		}
	}
{%- endstyle -%}
<div class="shopify-section-tab-header page-width {% if section.settings.fetch_init_key_from_site_url %} fetch_init_key_from_site {% endif %}" group="{{ section.settings.group }}">
	<div class="tab-header">
    <div class="tab-header-content">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="tab-header-item" key="{{ block.settings.key }}">{{ block.settings.tab_item_text }}</a>
        {%- else -%}
          <span class="tab-header-item" key="{{ block.settings.key }}">{{ block.settings.tab_item_text }}</span>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <span class="tab-thumb"></span>
  </div>
</div>
{% schema %}
{
  "name": "Tab Header",
  "tag": "section",
  "class": "shopify-section--tab-header",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fff"
    },
		{
			"type": "text",
			"id": "group",
			"label": "Group"
		},
    {
      "type": "checkbox",
      "id": "fetch_init_key_from_site_url",
      "label": "Fetch Key From Site URL",
      "default": false
    },
    {
      "type": "color",
      "id": "tab_bg_color",
      "label": "Tab Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Tab Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tab_bg_color_selected",
      "label": "Tab Background Color when Selected",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tab_text_color_selected",
      "label": "Tab Text Color when Selected",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
	"blocks": [
		{
			"type": "tab_item",
			"name": "Tab Item",
			"settings": [
				{
					"type": "text",
					"id": "tab_item_text",
					"label": "Tab Item Text"
				},
				{
					"type": "text",
					"id": "key",
					"label": "Key"
				},
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
			]
		}
	],
  "presets": [
    {
      "name": "Tab Header",
      "settings": {}
    }
  ]
}
{% endschema %}
