{{ 'contact-form-new.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
     padding-top: {{ section.settings.desktop_padding_top }}px;
     padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
     background-color: {{ section.settings.bg_color }};
   }
   @media screen and (max-width: 749px) {
     #shopify-section-{{ section.id }} {
       padding-top: {{ section.settings.mobile_padding_top }}px;
       padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
     }
   }
{%- endstyle -%}
<div class="shopify-section-cfn page-width">
  <div class="text-content">
    {%- if section.settings.heading != blank -%}
      <h1 class="heading" style="color: {{ section.settings.heading_color |  default : '#000' }}">
        {{ section.settings.heading }}
      </h1>
    {%- endif -%}
    {%- if section.settings.sub_heading != blank -%}
      <h2 class="sub-heading" style="color: {{ section.settings.sub_heading_color |  default : '#000' }}">
        {{ section.settings.sub_heading }}
      </h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="description" style="color: {{ section.settings.description_color |  default : '#000' }}">
        {{ section.settings.description }}
      </div>
    {%- endif -%}
  </div>
  {%- assign rgb = section.settings.box_shadow_color | color_to_rgb | remove: 'rgb(' | remove: ')' -%}
  <div
    class="form-content"
    style="border-radius: {{ section.settings.border_radius }}px; background-color: {{ section.settings.form_bg_color }}; box-shadow: 0px 0px 64px 0px rgba({{ rgb }} ,0.15)"
  >
    {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
      {%- if form.posted_successfully? -%}
        <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
          {{- 'icon-success.svg' | inline_asset_content -}}
          {{ 'templates.contact.form.post_success' | t }}
        </h2>
      {%- elsif form.errors -%}
        <div class="form-error">
          <div class="form__message">
            <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
              {{- 'icon-error.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.error_heading' | t }}
            </h2>
          </div>
          <ul class="form-status-list caption-large" role="list">
            <li>
              <a href="#ContactForm-email" class="link">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
                {{ form.errors | json }}
              </a>
            </li>
          </ul>
        </div>
      {%- endif -%}
      {%- if section.settings.form_logo != blank -%}
        <div class="logo">
          <img src="{{ section.settings.form_logo |  img_url: '150x' }}" alt="" width="150px" height="auto">
        </div>
      {%- endif -%}
      {%- assign step_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'first_step' -%}
            {% assign step_count = step_count | plus: 1 %}
            {%- render 'first-step-form-secton', block: block, index: forloop.index, childBlocks: section.blocks -%}
          {%- when 'second_step' -%}
            {%- if block.settings.is_independent == true -%}
              {% assign step_count = step_count | plus: 1 %}
              {%- render 'second-step-form-section',
                block: block,
                index: forloop.index,
                childBlocks: section.blocks,
                is_independent: block.settings.is_independent
              -%}
            {%- endif -%}
          {%- when 'third_step' -%}
            {%- if block.settings.is_independent == true -%}
              {% assign step_count = step_count | plus: 1 %}
              {%- render 'third-step-form-section',
                block: block,
                index: forloop.index,
                childBlocks: section.blocks,
                is_independent: block.settings.is_independent
              -%}
            {%- endif -%}
        {%- endcase -%}
        {%- if block.settings.final_step -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.nex_step_button_text != blank -%}
        <button class="next-step show">{{ section.settings.nex_step_button_text }}</button>
        {%- style -%}
          #shopify-section-{{ section.id }} .shopify-section-cfn .next-step {
          	color: {{ section.settings.next_step_button_color |  default: "white" }};
          	background-color: {{ section.settings.next_step_button_bg_color |  default: 'black' }};
          	border-radius: {{ section.settings.next_step_button_border_radius }}px;
          	background-position: center;
          		transition: background 0.8s;
          }
          #shopify-section-{{ section.id }} .shopify-section-cfn .next-step:hover {
          	color: {{ section.settings.next_step_button_color_hover |  default : 'white' }};
          	background: {{ section.settings.next_step_button_bg_color_hover }} radial-gradient(circle, transparent 1%, {{ section.settings.next_step_button_bg_color_hover }} 1%) center/15000%;
          }
          #shopify-section-{{ section.id }} .shopify-section-cfn .next-step:active {
          	background-color: {{ section.settings.next_step_button_bg_color_active |  default : 'white' }};
          	background-size: 100%;
          		transition: background 0s;
          }
        {%- endstyle -%}
      {%- endif -%}
      <div class="progressbar show" style="background-color: {{ section.settings.progress_bar_bg_color }};">
        {%- assign item_percent = 100.0 | divided_by: step_count -%}
        <div
          class="progress-track"
          style="background-color: {{ section.settings.progress_bar_track_color }}; width:{{ item_percent }}%"
          item-percent="{{ item_percent }}"
        ></div>
      </div>
      {%- if section.settings.back_button_text != blank -%}
        <button class="back-step" style="color: {{ section.settings.back_button_color }}">
          {{ section.settings.back_button_text }}
        </button>
      {%- endif -%}
      {%- assign stepBlocks = section.blocks | where: 'type', 'step' -%}
      {%- if stepBlocks.size > 0 -%}
        <div class="steps">
          {%- for block in stepBlocks -%}
            <div
              class="step-item"
              style="background-color: {{ block.settings.bg_color }}; border-radius: {{ block.settings.border_radius }}px;"
            >
              <div class="title">
                <span
                  class="number"
                  style="background-color: {{ block.settings.badge_bg_color }};color: {{ block.settings.badge_text_color }}; border: 2px solid {{ block.settings.badge_border_color }};"
                >
                  {{- forloop.index -}}
                </span>
                <p style="color: {{ block.settings.title_color }}">{{ block.settings.title }}</p>
              </div>
              {%- if block.settings.description != blank -%}
                <p class="description" style="color: {{ block.settings.description_color }}">
                  {{ block.settings.description }}
                </p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>
