{{ 'home-advertise.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
  	padding-top: {{ section.settings.desktop_padding_top }}px;
  	padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .advertise-card {
    background-color: {{ section.settings.bg_color }};
  }
  @media screen and (max-width: 749px) {
  	#shopify-section-{{ section.id }} {
  		padding-top: {{ section.settings.mobile_padding_top }}px;
  		padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  	}
  }
{%- endstyle -%}
<div class="shopify-section-home-advertise page-width">
  <div class="advertise-card">
    {%- if section.settings.main_image != blank -%}
      <div class="image-content">
        <div class="image-wrapper">
          <div class="image">
            <img src="{{ section.settings.main_image |  img_url: '800x' }}" alt="" width="800px" height="auto">
          </div>
          {%- if section.settings.hole_image != blank -%}
            <img src="{{ section.settings.hole_image |  img_url: '800x' }}" alt="" width="800px" height="auto">
          {%- endif -%}
        </div>
        {%- render 'image-cover', fill_color: {{ section.settings.bg_color }} -%}
      </div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="heading m-0">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="text m-0">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_link != blank and section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_link }}" class="link">{{ section.settings.button_text }}</a>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Home Advertise",
  "tag": "section",
  "class": "shopify-section--home-advertise",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "image_picker",
      "id": "hole_image",
      "label": "Hole Image"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Home Advertise",
      "settings": {}
    }
  ]
}
{% endschema %}
