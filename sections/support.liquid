{{ 'support.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
  	padding-top: {{ section.settings.desktop_padding_top }}px;
  	padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .support-card {
    background-color: {{ section.settings.bg_color }};
    border-radius: {{ section.settings.border_radius }}px;
    {%- if section.settings.show_border == true -%}
      border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    {%- endif -%}
  }
  @media screen and (max-width: 749px) {
  	#shopify-section-{{ section.id }} {
  		padding-top: {{ section.settings.mobile_padding_top }}px;
  		padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  	}
  }
{%- endstyle -%}
<div class="shopify-section-support page-width">
  <div class="support-card">
    <div class="image">
      {%- render 'image-sit' -%}
    </div>
    <div class="text-content">
      {%- if section.settings.heading != blank -%}
        {%- if section.settings.hero_section -%}
          <h1 class="heading m-0">{{ section.settings.heading }}</h1>
        {%- else -%}
          <h2 class="heading m-0">{{ section.settings.heading }}</h2>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="text m-0">{{ section.settings.text }}</p>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="text-list">
          {%- for block in section.blocks -%}
            {%- if block.settings.text != blank -%}
              <div class="text-item">
                {%- render 'icon-check' -%}
                <p class="block-text m-0">{{ block.settings.text }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Support",
  "tag": "section",
  "class": "shopify-section--support",
  "settings": [
    {
      "type": "checkbox",
      "id": "hero_section",
      "label": "Hero Section",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show Border",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Border Radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "icon_with_text",
      "name": "Icon with Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Support",
      "settings": {}
    }
  ]
}
{% endschema %}
