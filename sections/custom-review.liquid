{{ 'custom-review.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
  	padding-top: {{ section.settings.desktop_padding_top }}px;
  	padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
  	#shopify-section-{{ section.id }} {
  		padding-top: {{ section.settings.mobile_padding_top }}px;
  		padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  	}
  }
{%- endstyle -%}
<div class="shopify-section-custom-review page-width">
	{%- if section.settings.heading != blank -%}
		<h1 class="heading m-0">{{ section.settings.heading }}</h1>
	{%- endif -%}
	{%- if section.blocks.size > 0 -%}
		<div class="custom-review-list">
			{%- for block in section.blocks -%}
				<div class="custom-review-item" style="background-color: {{ block.settings.bg_color }}; {% if block.settings.show_border == true %} border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }}; {% endif %} border-radius: {{ block.settings.border_radius }}px">
					{%- if block.settings.review_text != blank -%}
						<div class="review-text">{{ block.settings.review_text }}</div>
					{%- endif -%}
					<div class="author-info">
						{%- if block.settings.author_avatar != blank -%}
							<div class="avartar">
								<img src="{{ block.settings.author_avatar |  img_url: '100x' }}" alt="" width="100px" height="auto">
							</div>
							<div class="author-text">
								{%- if block.settings.author_name != blank -%}
									<h2 class="author-name m-0">{{ block.settings.author_name }}</h2>
								{%- endif -%}
								{%- if block.settings.author_info_text != blank -%}
									<p class="author_info_text m-0">{{ block.settings.author_info_text }}</p>
								{%- endif -%}
							</div>
						{%- endif -%}
					</div>
				</div>
			{%- endfor -%}
		</div>
	{%- endif -%}
</div>
{% schema %}
{
  "name": "Custom Review",
  "tag": "section",
  "class": "shopify-section--custom-review",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "review_item",
      "name": "Review Item",
      "settings": [
        {
          "type": "richtext",
          "id": "review_text",
          "label": "Review Text"
        },
        {
          "type": "image_picker",
          "id": "author_avatar",
          "label": "Author Avatar"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name"
        },
        {
          "type": "text",
          "id": "author_info_text",
          "label": "Author Info Text"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background Color",
          "default": "#000000"
        },
        {
          "type": "checkbox",
          "id": "show_border",
          "label": "Show Border",
          "default": true
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Border Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "border_width",
          "min": 0,
          "max": 10,
          "step": 1,
          "unit": "px",
          "label": "Border Width",
          "default": 0
        },
        {
          "type": "range",
          "id": "border_radius",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Border Radius",
          "default": 0
        }
      ]
    }
  ]
}
{% endschema %}
