{% schema %}
  {
    "name": "Custom Header",
    "tag": "header",
    "class": "shopify-header",
    "settings": [
      {
        "type": "link_list",
        "id": "main_menu",
        "label": "Main Navigation Menu"
      },
      {
        "type": "link_list",
        "id": "popular_services_menu",
        "label": "Popular Services Menu"
      },
      {
        "type": "link_list",
        "id": "trades_menu",
        "label": "Trades Menu"
      },

      {
        "type": "image_picker",
        "id": "logo_image",
        "label": "Logo Image"
      }, 
   
      
      {
        "type": "text",
        "id": "phone_number",
        "label": "Phone Number"
      }, {
        "type": "text",
        "id": "phone_number_button_text",
        "label": "Phone Number Button Text"
      }, {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color",
        "default": "#ffd829"
      }
    ],
    "blocks": [
      {
        "type": "mega_menu",
        "name": "Mega Menu",
        "settings": [
          {
            "type": "text",
            "id": "handle",
            "label": "Menu Handle"
          }
        ]
      }, {
        "type": "menu_item_image",
        "name": "Menu Item Image",
        "settings": [
          {
            "type": "text",
            "id": "image_list",
            "label": "Image List"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Custom Header",
        "blocks": [
          {
            "type": "mega_menu"
          }, {
            "type": "menu_item_image"
          }
        ]
      }
    ]
  }
{% endschema %}
<script>
  
  
  
  document.addEventListener("DOMContentLoaded", function () {
    // Mega Menu for Services
    const servicesMenu = document.getElementById("services-menu");
    const megaMenu = document.querySelector(".mega-menu");
  
    if (servicesMenu && megaMenu) {
        // Toggle mega menu when clicking "Services"
        servicesMenu.addEventListener("click", function (event) {
            event.preventDefault();
            megaMenu.classList.toggle("active");
  
            // Close all other dropdowns
            document.querySelectorAll(".submenu").forEach((submenu) => {
                submenu.classList.remove("active");
            });
        });
  
        // Close mega menu when clicking outside
        document.addEventListener("click", function (event) {
            if (!event.target.closest(".has-mega-menu")) {
                megaMenu.classList.remove("active");
            }
        });
    }
  
    // Handle Other Dropdowns (e.g., Trades menu)
    const dropdownItems = document.querySelectorAll(".has-dropdown");
  
    dropdownItems.forEach((dropdown) => {
        const link = dropdown.querySelector(".nav-link");
        const submenu = dropdown.querySelector(".submenu");
  
        if (link && submenu) {
            link.addEventListener("click", function (event) {
                event.preventDefault();
                submenu.classList.toggle("active");
  
                // Close mega menu when another dropdown is opened
                megaMenu.classList.remove("active");
            });
  
            // Close dropdown when clicking outside
            document.addEventListener("click", function (event) {
                if (!event.target.closest(".has-dropdown")) {
                    submenu.classList.remove("active");
                }
            });
        }
    });
  
  
   const mobileToggle = document.querySelector(".mobile-toggle");
  const navList = document.querySelector(".main-nav .nav-list");
  
  if (mobileToggle && navList) {
    mobileToggle.addEventListener("click", function () {
      // Toggle the .nav-open class on the nav-list
      navList.classList.toggle("nav-open");
      // Toggle the .active class on the hamburger
      mobileToggle.classList.toggle("active");
    });
  }
  });
</script>