{% schema %}
{
  "name": "Benefits Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_id",
      "label": "Section Id"
    },
    {
      "type": "text",
      "id": "key",
      "label": "Key"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Why Having an Online Presence Matters"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fff"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "text",
          "id": "benefit_title",
          "label": "Benefit Title",
          "default": "Reach A Wider Audience"
        },
        {
          "type": "textarea",
          "id": "benefit_description",
          "label": "Benefit Description",
          "default": "By having a presence online, you can reach a much larger audience looking for your service than you would through traditional marketing methods."
        },
        {
          "type": "image_picker",
          "id": "benefit_icon",
          "label": "Benefit Icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Benefits Grid",
      "category": "Custom Sections",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
      ]
    }
  ]
}
{% endschema %}

<link rel="stylesheet" href="{{ 'benefits-section.css' | asset_url }}">
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }
  @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      }
  }
{%- endstyle -%}
<section class="benefits-section page-width" {% if section.settings.key != blank %} tab key="{{ section.settings.key }}" {% endif %} {% if section.settings.section_id != blank %} id="{{ section.settings.section_id }}" {% endif %}>
  <div class="benefits-container">
    {% for block in section.blocks %}
      <div class="benefit-card">
        <div class="benefit-header">
          <h3>{{ block.settings.benefit_title }}</h3>
          {% if block.settings.benefit_icon %}
            <img src="{{ block.settings.benefit_icon | image_url }}" alt="Benefit Icon" class="benefit-icon">
          {% endif %}
        </div>
        <p>{{ block.settings.benefit_description }}</p>
      </div>
    {% endfor %}
  </div>
</section>
