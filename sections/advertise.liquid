{{ 'advertise.css' | asset_url | stylesheet_tag }}
{{ 'video-section.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- style -%}
   #shopify-section-{{ section.id }} {
     padding-top: {{ section.settings.desktop_padding_top }}px;
     padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
		 background-color: {{ section.settings.background_color }};
     color: {{ section.settings.text_color }};
   }
   #shopify-section-{{ section.id }} .advertise-media video,#shopify-section-{{ section.id }} .advertise-media .main-image {
    border-radius: {{ section.settings.media_border_radius }}px;
    border: {{ section.settings.media_border_width }}px solid {{ section.settings.media_border_color |  default : 'transparent' }};
   }
   #shopify-section-{{ section.id }} .badge {
    border-radius: {{ section.settings.badge_border_radius }}px;
    background-color: {{ section.settings.badge_bg_color }};
    color: {{ section.settings.badge_txt_color }};
   }
	 @media screen and (min-width: 750px) {
		#shopify-section-{{ section.id }} .secondary-image {
			{%- if section.settings.desktop_left != -1 -%}
				left: {{ section.settings.desktop_left }}px;
			{%- endif -%}
			{%- if section.settings.desktop_top != -1 -%}
				top: {{ section.settings.desktop_top }}px;
			{%- endif -%}
			{%- if section.settings.desktop_right != -1 -%}
				right: {{ section.settings.desktop_right }}px;
			{%- endif -%}
			{%- if section.settings.desktop_bottom != -1 -%}
				bottom: {{ section.settings.desktop_bottom }}px;
			{%- endif -%}
		}
	 }
   @media screen and (max-width: 749px) {
     #shopify-section-{{ section.id }} {
       padding-top: {{ section.settings.mobile_padding_top }}px;
       padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
     }
  	#shopify-section-{{ section.id }} .secondary-image {
  		{%- if section.settings.mobile_left != -1 -%}
  			left: {{ section.settings.mobile_left }}px;
  		{%- endif -%}
  		{%- if section.settings.mobile_top != -1 -%}
  			top: {{ section.settings.mobile_top }}px;
  		{%- endif -%}
  		{%- if section.settings.mobile_right != -1 -%}
  			right: {{ section.settings.mobile_right }}px;
  		{%- endif -%}
  		{%- if section.settings.mobile_bottom != -1 -%}
  			bottom: {{ section.settings.mobile_bottom }}px;
  		{%- endif -%}
  	}
   }
{%- endstyle -%}
<div class="shopify-section-advertise page-width {% if section.settings.image_right == true %} media-right {% endif %}" {% if section.settings.key != blank %} tab key="{{ section.settings.key }}" {% endif %}>
  <div class="advertise-media {% if section.settings.hide_media_on_mobile %} hide_on_mobile {% endif %}">
    {%- if section.settings.video != null or section.settings.video_url != blank -%}
      <video muted {% if section.settings.autoplay_video %}autoplay{% else %}controls{% endif %} playsinline {% if section.settings.loop_video %}loop{% endif %}>
      {%- for source in section.settings.video.sources -%}
        <source src="{{ source.url }}" type="video/{{ source.format }}">
      {%- endfor -%}
    </video>
    {%- else -%}
      {%- if section.settings.main_image != blank -%}
        <img
          src="{{ section.settings.main_image |  img_url: '1000x' }}"
          alt=""
          width="1000px"
          height="auto"
          class="main-image"
        >
      {%- endif -%}
      {%- if section.settings.secondary_image != blank -%}
        <div class="secondary-image">
          <img
            src="{{ section.settings.secondary_image |  img_url: '200x' }}"
            alt=""
            width="200px"
            height="auto"
            style="transform: rotate({{ section.settings.secondary_image_roate_angle }}deg);"
          >
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
  <div class="text-content align-{{ section.settings.text_align }}">
    {%- if section.settings.badge_text != blank -%}
      <span class="badge {% if section.settings.hide_badge_on_mobile %} hide_on_mobile {% endif %}">{{ section.settings.badge_text }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="heading m-0">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.sub_heading != blank -%}
      <h2 class="sub-heading m-0 {% if section.settings.hide_subheading_on_mobile %} hide_on_mobile {% endif %}">{{ section.settings.sub_heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="text {% if section.settings.hide_text_on_mobile %} hide_on_mobile {% endif %}">
        <p class="advertise-text">{{ section.settings.text }}</p></div>
    {%- endif -%}
    {%- assign textItems = section.blocks |  where: 'type', 'text_item' |  map: 'settings' -%}
    {%- if textItems.size > 0 -%}
      <div class="text-item-list">
        {%- for textItem in textItems -%}
          {%- if textItem.icon != blank or textItem.text != blank -%}
            <div class="text-item">
              {%- if textItem.icon != blank -%}
                <img src="{{ textItem.icon |  img_url: '30x' }}" alt="" width="30px" height="auto">
              {%- endif -%}
              {%- if textItem.text != blank -%}
                <span>{{ textItem.text }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- assign contactForm = section.blocks |  where: 'type', 'contact_form' | map: 'settings' | first -%}
    {%- assign form_id = section.id | append: '-single-contact-form' -%}
    {%- render 'single-contact-form', form_settings: contactForm,id: form_id -%}
    <div class="link-list">
      {%- if section.settings.button_link != blank and section.settings.button_text != blank -%}
        <a href="{{ section.settings.button_link }}" class="link">{{ section.settings.button_text }}</a>
      {%- endif -%}
      {%- assign linkBlocks = section.blocks |  where: 'type', 'link' -%}
      {%- for linkBlock in linkBlocks -%}
        {%- if linkBlock.settings.link != blank and linkBlock.settings.link_text != blank -%}
          <a href="{{ linkBlock.settings.link }}" class="link" id="link-{{ linkBlock.id }}">{{ linkBlock.settings.link_text }}</a>
          {%- style -%}
            #link-{{ linkBlock.id }} {
              background-color: {{ linkBlock.settings.bg_color }};
              color: {{ linkBlock.settings.txt_color }};
              border: 1px solid {{ linkBlock.settings.border_color }};
              border-radius: {{ linkBlock.settings.border_radius }}px;
            }
            #link-{{ linkBlock.id }}:hover {
              background-color: {{ linkBlock.settings.bg_color_hover }};
              color: {{ linkBlock.settings.txt_color_hover }};
              border: 1px solid {{ linkBlock.settings.border_color_hover }};
            }
          {%- endstyle -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    {%- assign logos = section.blocks |  where: 'type', 'logo' |  map: 'settings' -%}
    {%- if logos.size > 0 -%}
      <div class="logo-list">
        {%- for logo in logos -%}
          {%- if logo.logo != blank -%}
            {%- if logo.link != blank -%}
              <a href="{{ logo.link }}" class="logo">
                <img src="{{ logo.logo |  img_url: '300x' }}" alt="" width="300px" height="auto">
              </a>
            {%- else -%}
              <div class="logo">
                <img src="{{ logo.logo |  img_url: '300x' }}" alt="" width="300px" height="auto">
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
