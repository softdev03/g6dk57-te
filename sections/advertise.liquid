{{ 'advertise.css' | asset_url | stylesheet_tag }}
{{ 'video-section.css' | asset_url | stylesheet_tag }}
{{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
{%- style -%}
   #shopify-section-{{ section.id }} {
     padding-top: {{ section.settings.desktop_padding_top }}px;
     padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
		 background-color: {{ section.settings.background_color }};
   }
	 @media screen and (min-width: 750px) {
		#shopify-section-{{ section.id }} .secondary-image {
			{%- if section.settings.desktop_left != -1 -%}
				left: {{ section.settings.desktop_left }}px;
			{%- endif -%}
			{%- if section.settings.desktop_top != -1 -%}
				top: {{ section.settings.desktop_top }}px;
			{%- endif -%}
			{%- if section.settings.desktop_right != -1 -%}
				right: {{ section.settings.desktop_right }}px;
			{%- endif -%}
			{%- if section.settings.desktop_bottom != -1 -%}
				bottom: {{ section.settings.desktop_bottom }}px;
			{%- endif -%}
		}
	 }
   @media screen and (max-width: 749px) {
     #shopify-section-{{ section.id }} {
       padding-top: {{ section.settings.mobile_padding_top }}px;
       padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
     }
  	#shopify-section-{{ section.id }} .secondary-image {
  		{%- if section.settings.mobile_left != -1 -%}
  			left: {{ section.settings.mobile_left }}px;
  		{%- endif -%}
  		{%- if section.settings.mobile_top != -1 -%}
  			top: {{ section.settings.mobile_top }}px;
  		{%- endif -%}
  		{%- if section.settings.mobile_right != -1 -%}
  			right: {{ section.settings.mobile_right }}px;
  		{%- endif -%}
  		{%- if section.settings.mobile_bottom != -1 -%}
  			bottom: {{ section.settings.mobile_bottom }}px;
  		{%- endif -%}
  	}
   }
{%- endstyle -%}
<div class="shopify-section-advertise page-width {% if section.settings.image_right == true %} media-right {% endif %}">
  <div class="advertise-media {% if section.settings.media_sticky %} sticky {% endif %}">
    {%- if section.settings.video != null or section.settings.video_url != blank -%}
      <video muted {% if section.settings.autoplay_video %}autoplay{% else %}controls{% endif %} playsinline {% if section.settings.loop_video %}loop{% endif %}>
      {%- for source in section.settings.video.sources -%}
        <source src="{{ source.url }}" type="video/{{ source.format }}">
      {%- endfor -%}
    </video>
    {%- else -%}
      {%- if section.settings.main_image != blank -%}
        <img
          src="{{ section.settings.main_image |  img_url: '1000x' }}"
          alt=""
          width="1000px"
          height="auto"
          class="main-image"
        >
      {%- endif -%}
      {%- if section.settings.secondary_image != blank -%}
        <div class="secondary-image">
          <img
            src="{{ section.settings.secondary_image |  img_url: '200x' }}"
            alt=""
            width="200px"
            height="auto"
            style="transform: rotate({{ section.settings.secondary_image_roate_angle }}deg);"
          >
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
  <div class="text-content align-{{ section.settings.text_align }}">
    {%- if section.settings.heading != blank -%}
      <h1 class="heading m-0">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.sub_heading != blank -%}
      <h2 class="sub-heading m-0">{{ section.settings.sub_heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="text">
        <p class="advertise-text">{{ section.settings.text }}</p></div>
    {%- endif -%}
    {%- if section.settings.button_link != blank and section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_link }}" class="link">{{ section.settings.button_text }}</a>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Advertise",
  "tag": "section",
  "class": "shopify-section--advertise",
  "settings": [
    {
      "type": "header",
      "content": "Viedo Settings"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "checkbox",
      "id": "loop_video",
      "label": "Loop Video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay_video",
      "label": "Autoplay Video",
      "default": true
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main Image"
    },
    {
      "type": "image_picker",
      "id": "secondary_image",
      "label": "Secondary Image"
    },
		{
			"type": "header",
			"content": "Secondary Image Settings"
		},
		{
			"type": "range",
			"id": "secondary_image_roate_angle",
			"min": -180,
			"max": 180,
			"step": 4,
			"unit": "deg",
			"label": "Secondary Image Rotate Angle",
			"default": 12
		},
		{
			"type": "number",
			"id": "desktop_left",
			"label": "Desktop Left",
			"default": -1
		},
		{
			"type": "number",
			"id": "desktop_top",
			"label": "Desktop Top",
			"default": -1
		},
		{
			"type": "number",
			"id": "desktop_right",
			"label": "Desktop Right",
			"default": -1
		},
		{
			"type": "number",
			"id": "desktop_bottom",
			"label": "Desktop Bottom",
			"default": -1
		},
		{
			"type": "number",
			"id": "mobile_left",
			"label": "Mobile Left",
			"default": -1
		},
		{
			"type": "number",
			"id": "mobile_top",
			"label": "Mobile Top",
			"default": -1
		},
		{
			"type": "number",
			"id": "mobile_right",
			"label": "Mobile Right",
			"default": -1
		},
		{
			"type": "number",
			"id": "mobile_bottom",
			"label": "Mobile Bottom",
			"default": -1
		},
    {
      "type": "header",
      "content": "Text Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
		{
			"type": "checkbox",
			"id": "image_right",
			"label": "Media Right",
			"default": true
		},
		{
			"type": "select",
			"id": "text_align",
			"label": "Text Align",
			"options": [
				{
					"value": "left",
					"label": "Left"
				},
				{
					"value": "center",
					"label": "Center"
				},
				{
					"value": "right",
					"label": "Right"
				}
			],
			"default": "left"
		},
		{
			"type": "color",
			"id": "background_color",
			"label": "Background Color",
			"default": "#fff"
		},
    {
      "type": "header",
      "content": "Padding Setting"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Advertise",
      "settings": {}
    }
  ]
}
{% endschema %}
