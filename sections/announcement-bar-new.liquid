{{ 'abn.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="shopify-section-abn page-width">
  <p class="own-text">{{ section.settings.own_text }}</p>
  <div class="trust">
    <p class="trust-text">{{ section.settings.trust_text }}</p>
    <img src="{{ section.settings.trust_img |  img_url: '120x' }}" alt="" width="120px" height="auto">
  </div>
</div>
{% schema %}
{
  "name": "Announcement Bar New",
  "tag": "section",
  "class": "shopify-section--announcement-bar",
  "settings": [
    {
      "type": "text",
      "id": "own_text",
      "label": "Own Text"
    },
    {
      "type": "text",
      "id": "trust_text",
      "label": "Trust Text"
    },
    {
      "type": "image_picker",
      "id": "trust_img",
      "label": "Trust Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar New",
      "settings": {}
    }
  ]
}
{% endschema %}
