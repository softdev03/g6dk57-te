{% schema %}
{
  "name": "Services Grid",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Our Services"
    }
  ],
  "blocks": [
    {
      "type": "service",
      "name": "Service",
      "settings": [
        {
          "type": "image_picker",
          "id": "service_icon",
          "label": "Service Icon"
        },
        {
          "type": "text",
          "id": "service_title",
          "label": "Service Title",
          "default": "Marketing For Tradies"
        },
        {
          "type": "url",
          "id": "service_link",
          "label": "Service Link",
          
        },
        {
          "type": "text",
          "id": "service_description",
          "label": "Service Description",
          "default": "We'll help you stand out in the crowded tradie market."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Services Grid",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

<link rel="stylesheet" href="{{ 'services-grid.css' | asset_url }}">

<section class="services-section page-width">
  <!-- Example: show a dynamic section heading if desired -->
  {% if section.settings.section_title != blank %}
    <h2 class="services-title">{{ section.settings.section_title }}</h2>
  {% endif %}

  <div class="services-grid">
    {% for block in section.blocks %}
      {% if block.type == 'service' %}
        <div class="service-item">
          <div class="service-icon">
            {% if block.settings.service_icon %}
              <img 
                src="{{ block.settings.service_icon | img_url: '200x' }}" 
                alt="{{ block.settings.service_title | escape }}"
              >
            {% endif %}
          </div>
          <h3 class="service-title">
            <!-- If the client wants the title linked -->
            <a href="{{ block.settings.service_link | escape }}">
              {{ block.settings.service_title }}
            </a>
          </h3>
          <p class="service-description">
            {{ block.settings.service_description }}
          </p>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>




