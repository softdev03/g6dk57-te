{{ 'our-office-pos.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .main-content {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    border: 2px solid {{ section.settings.border_color }};
  }
  @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      }
  }
{%- endstyle -%}
<div class="shopify-section-office-pos page-width">
  <div class="main-content">
    <div class="text-content">
      {%- if section.settings.heading != blank -%}
        {%- if section.settings.hero_section -%}
          <h1 class="heading m-0">{{ section.settings.heading }}</h1>
        {%- else -%}
          <h2 class="heading m-0">{{ section.settings.heading }}</h2>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="text">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    <div class="image-content">
      {%- if section.settings.landing_image != blank -%}
        <div class="landing-image">
          <img src="{{ section.settings.landing_image| img_url: '800x' }}" alt="" width="800px" height="auto">
        </div>
        {%- if section.settings.direction_image != blank -%}
          <div class="direction-image">
            <img src="{{ section.settings.direction_image| img_url: '300x' }}" alt="" width="300px" height="auto">
            {%- if section.settings.direction_text != blank -%}
              <p class="direction-text m-0">{{ section.settings.direction_text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Our Office Lcoation",
  "tag": "section",
  "class": "shopify-section--office-pos",
  "settings": [
    {
      "type": "checkbox",
      "id": "hero_section",
      "label": "Hero Section",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "direction_text",
      "label": "Direction Text"
    },
    {
      "type": "image_picker",
      "id": "landing_image",
      "label": "Landing Image"
    },
    {
      "type": "image_picker",
      "id": "direction_image",
      "label": "Direction Image"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Our Office Lcoation",
      "settings": {}
    }
  ]
}
{% endschema %}
