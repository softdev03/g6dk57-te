{{ 'footer-second.css' | asset_url | stylesheet_tag }}
{% style %}
   #shopify-section-{{ section.id }} {
     background-color: {{ section.settings.bg_color }};
     padding-top: {{ section.settings.desktop_padding_top }}px;
      padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
   }
   #shopify-section-{{ section.id }} .svg-wrapper {
    background-color: {{ section.settings.social_icon_bg_color }};
   }
   #shopify-section-{{ section.id }} .svg-wrapper:hover {
    background-color: {{ section.settings.social_icon_bg_color_hover }};
   }
   #shopify-section-{{ section.id }} .svg-wrapper path {
    fill: {{ section.settings.social_icon_color }};
    stroke: {{ section.settings.social_icon_color }};
   }
   #shopify-section-{{ section.id }} .svg-wrapper:hover path {
    fill: {{ section.settings.social_icon_color_hover }};
    stroke: {{ section.settings.social_icon_color_hover }};
   }
   @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}
<section class="page-width shopify-section-footer-second">
  <div class="footer-second">
    <div class="footer-second-left">
      <div class="footer-second-left-logo">
        <img
          src="{{ section.settings.left_logo | image_url }}"
        >
      </div>
      <div class="footer-second-left-desc">{{ section.settings.left_desc }}</div>
    </div>
    <div
      class="location mobile {% if section.settings.map_right %} map-right {% endif %}"
      style="color: {{ section.settings.location_text_color }}"
    >
      <div class="map {% if section.settings.show_map_on_mobile == false %} hide_on_mobile {% endif %}"></div>
      <div class="location-details">
        <div class="location-contact">
          {%- if section.settings.contact_heading != blank -%}
            <h2 class="contact-heading">
              {{ section.settings.contact_heading }}
              {%- if section.settings.contact_image != blank -%}
                <img src="{{ section.settings.contact_image |  img_url: '50x' }}" alt="" width="50px" height="auto">
              {%- endif -%}
            </h2>
          {%- endif -%}
          {%- render 'social-icons', class: 'footer__list-social' -%}
        </div>
        <div class="description-wrapper">
          {%- if section.settings.location_first_description != blank -%}
            <div class="description">{{ section.settings.location_first_description }}</div>
          {%- endif -%}
          {%- if section.settings.location_second_description != blank -%}
            <div class="description">{{ section.settings.location_second_description }}</div>
          {%- endif -%}
        </div>
        <div class="image-items">
          {%- for block in section.blocks -%}
            {%- if block.settings.image != blank -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" class="image-item">
                  <img src="{{ block.settings.image |  img_url: '100x' }}" alt="" width="100px" height="auto">
                </a>
              {%- else -%}
                <div class="image-item">
                  <img src="{{ block.settings.image |  img_url: '100x' }}" alt="" width="100px" height="auto">
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
    <div class="footer-second-right">
      <div class="footer-second-right-image">
        <img
          src="{{ section.settings.right_img | image_url }}"
        >
      </div>

      <a href="{{ section.settings.button_link }}" class="footer-second-right-btn">
        {{ section.settings.button_label }}
      </a>
    </div>
  </div>
  <div
    class="location desktop {% if section.settings.map_right %} map-right {% endif %}"
    style="color: {{ section.settings.location_text_color }}"
  >
    <div class="map {% if section.settings.show_map_on_mobile == false %} hide_on_mobile {% endif %}"></div>
    <div class="location-details">
      <div class="location-contact">
        {%- if section.settings.contact_heading != blank -%}
          <h2 class="contact-heading">
            {{ section.settings.contact_heading }}
            {%- if section.settings.contact_image != blank -%}
              <img src="{{ section.settings.contact_image |  img_url: '50x' }}" alt="" width="50px" height="auto">
            {%- endif -%}
          </h2>
        {%- endif -%}
        {%- render 'social-icons', class: 'footer__list-social' -%}
      </div>
      <div class="description-wrapper">
        {%- if section.settings.location_first_description != blank -%}
          <div class="description">{{ section.settings.location_first_description }}</div>
        {%- endif -%}
        {%- if section.settings.location_second_description != blank -%}
          <div class="description">{{ section.settings.location_second_description }}</div>
        {%- endif -%}
      </div>
      <div class="image-items">
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="image-item">
                <img src="{{ block.settings.image |  img_url: '100x' }}" alt="" width="100px" height="auto">
              </a>
            {%- else -%}
              <div class="image-item">
                <img src="{{ block.settings.image |  img_url: '100x' }}" alt="" width="100px" height="auto">
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Footer Second",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "image_picker",
      "id": "left_logo",
      "label": "Left Logo"
    },
    {
      "type": "text",
      "id": "left_desc",
      "label": "Left Desc"
    },
    {
      "type": "image_picker",
      "id": "right_img",
      "label": "Right Image"
    },

    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#FFD000"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Click Here"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Location Settings"
    },
    {
      "type": "checkbox",
      "id": "map_right",
      "label": "Map Right",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_map_on_mobile",
      "label": "Show Map on Mobile",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact Heading"
    },
    {
      "type": "image_picker",
      "id": "contact_image",
      "label": "Contact Image"
    },
    {
      "type": "richtext",
      "id": "location_first_description",
      "label": "First Description for Location"
    },
    {
      "type": "richtext",
      "id": "location_second_description",
      "label": "Second Description for Location"
    },
    {
      "type": "color",
      "id": "location_text_color",
      "label": "Text Color for Location",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "social_icon_bg_color",
      "label": "Social Icon Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "social_icon_color",
      "label": "Social Icon Color",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "social_icon_bg_color_hover",
      "label": "Social Icon Background Color when Hover",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "social_icon_color_hover",
      "label": "Social Icon Color when Hover",
      "default": "#fff"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "image_with_link",
      "name": "Image with Link",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Second",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
