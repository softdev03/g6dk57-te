{{ 'free-ai-tools.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
  	padding-top: {{ section.settings.desktop_padding_top }}px;
  	padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
  	#shopify-section-{{ section.id }} {
  		padding-top: {{ section.settings.mobile_padding_top }}px;
  		padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  	}
  }
{%- endstyle -%}
<div class="shopify-section-free-ai-tools page-width">
  {%- if section.settings.heading != blank -%}
    {%- if section.settings.hero_section -%}
      <h1 class="heading m-0">{{ section.settings.heading }}</h1>
    {%- else -%}
      <h2 class="heading m-0">{{ section.settings.heading }}</h2>
    {%- endif -%}
  {%- endif -%}
  {%- if section.settings.text != blank -%}
    <div class="text">{{ section.settings.text }}</div>
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="tools">
      {%- for block in section.blocks -%}
        <div class="tool-item {% if block.settings.featured %} featured {% endif %}">
          <div class="tool-item-content">
            <div class="image">
              {%- if block.settings.tool_image != blank -%}
                <img src="{{ block.settings.tool_image |  img_url: '700x' }}" alt="" width="700px" height="auto">
              {%- endif -%}
            </div>
            <div class="text-content">
              {%- if block.settings.heading != blank -%}
                <h2 class="sub-heading tool-heading m-0">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="text tool-text">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.tool_link != blank and block.settings.link_text != blank -%}
                <a href="{{ block.settings.tool_link }}" class="tool-link">
                  {{ block.settings.link_text }}
                  {{ 'icon-blue-arrow.svg' | inline_asset_content }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Free AI Tools",
  "tag": "section",
  "class": "shopify-section--free-ai-tools",
  "settings": [
    {
      "type": "checkbox",
      "id": "hero_section",
      "label": "Hero Section",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "free_ai_tool",
      "name": "Free AI Tool",
      "settings": [
        {
          "type": "image_picker",
          "id": "tool_image",
          "label": "Tool Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "tool_link",
          "label": "Tool Link"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Free AI Tools",
      "settings": {}
    }
  ]
}
{% endschema %}
