{{ 'service-pricing.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .border {
    margin-top: {{ section.settings.desktop_border_margin }}px;
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
    #shopify-section-{{ section.id }} .border {
      margin-top: {{ section.settings.mobile_border_margin }}px;
    }
  }
{%- endstyle -%}
<div class="shopify-section-service-pricing page-width">
  {%- if section.blocks.size > 0 -%}
    <div class="pricing-list">
      {%- for block in section.blocks -%}
        <div
          class="pricing-item"
          style="background-color: {{ block.settings.card_bg_color }}; color: {{ block.settings.card_text_color }}"
        >
          <div
            class="heading"
            style="color: {{ block.settings.header_color }}; background: {{ block.settings.header_bg_color }}"
          >
            {%- if block.settings.heading != blank -%}
              <h2 class="pricing-heading m-0">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.sub_heading != blank -%}
              <h3 class="pricing-sub-heading m-0">{{ block.settings.sub_heading }}</h3>
            {%- endif -%}
            {%- if block.settings.badge_text != blank -%}
              <div class="badge-wrapper">
                <p
                  class="badge-text"
                  style="color: {{ block.settings.badge_color }}; background-color: {{ block.settings.badge_bg_color }}"
                >
                  {{ block.settings.badge_text }}
                </p>
              </div>
            {%- endif -%}
          </div>
          <div class="content">
            <div class="payment">
              <div class="price-wrapper">
                <p class="symbol lh-1 m-0">{{ block.settings.price_symbol }}</p>
                <p class="price m-0 lh-1">{{ block.settings.price }}</p>
              </div>
              <p class="payment-method text-center lh-1 m-0">{{ block.settings.payment_method }}</p>
            </div>
            <div class="pricing-item-list">
              {%- for service_item in block.settings.pricing_items.service_item.value -%}
                <div class="service-item">
                  {%- if block.settings.pricing_items.icon != blank -%}
                    <div class="icon lh-0" style="background-color: {{ block.settings.button_bg_color }};">
                      <img
                        src="{{ block.settings.pricing_items.icon |  img_url: '20x' }}"
                        alt=""
                        width="20px"
                        height="20px"
                      >
                    </div>
                  {%- endif -%}
                  <p class="service-text m-0 lh-1">{{ service_item }}</p>
                </div>
              {%- endfor -%}
            </div>
            {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
              <a
                href="{{ block.settings.button_link }}"
                class="pricing-link"
                style="color: {{ block.settings.button_text_color }}; background-color: {{ block.settings.button_bg_color }}"
              >
                {{- block.settings.button_text -}}
              </a>
            {%- endif -%}
            <p class="pricing-text text-center m-0">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
  <p
    class="m-0 border"
    style="background-color: {{ section.settings.border_color }}; width: {{ section.settings.border_width }}%"
  ></p>
</div>
