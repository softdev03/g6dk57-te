{{ 'service-form.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
  	padding-top: {{ section.settings.desktop_padding_top }}px;
  	padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} form {
    background-color: {{ section.settings.form_bg_color }};
    border: {{ section.settings.form_border_width }}px solid {{ section.settings.form_border_color }};
    border-radius: {{ section.settings.form_border_radius }}px;
  }
  @media screen and (max-width: 749px) {
  	#shopify-section-{{ section.id }} {
  		padding-top: {{ section.settings.mobile_padding_top }}px;
  		padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  	}
  }
{%- endstyle -%}
<div class="shopify-section-service-form page-width">
  <div class="text-content">
    <div class="main-content">
      <h1 class="heading m-0">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          Heading
        {%- endif -%}
      </h1>
      <div class="text">
        {%- if section.settings.text != blank -%}
          {{ section.settings.text }}
        {%- else -%}
          Text
        {%- endif -%}
      </div>
      {%- if section.settings.show_faq -%}
        {%- assign faq_blocks = section.blocks | where: 'type', 'faq_item' -%}
        <div class="faq">
          {%- if faq_blocks.size > 0 -%}
            {%- for block in faq_blocks -%}
              <div class="accordion" type="group" container="#shopify-section-{{ section.id }}">
                <div class="accordion-heading">
                  {%- if block.settings.question != blank -%}
                    {{ block.settings.question }}
                  {%- else -%}
                    Question
                  {%- endif -%}
                  <div class="icon">
                    {{ 'icon-plus.svg' | inline_asset_content }}
                  </div>
                </div>
                <div class="accordion-content text">
                  {%- if block.settings.answer != blank -%}
                    {{ block.settings.answer }}
                  {%- else -%}
                    Answer
                  {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..10) -%}
              <div class="accordion" type="group" container="#shopify-section-{{ section.id }}">
                <div class="accordion-heading">
                  Question-{{ i }}
                  <div class="icon">
                    {{ 'icon-plus.svg' | inline_asset_content }}
                  </div>
                </div>
                <div class="accordion-content">Answer-{{ i }}</div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="contact-inform">
      {%- assign contact_cards = section.blocks | where: 'type', 'contact_info_card' -%}
      {%- for contact_card in contact_cards -%}
        <div class="contact-card">
          {%- if contact_card.settings.image != blank -%}
            <div class="image-wrapper" style="background-color: {{ contact_card.settings.image_bg_color }};">
              <div class="image">
                <img src="{{ contact_card.settings.image |  img_url: '200x' }}" alt="" width="200px" height="auto">
              </div>
            </div>
          {%- endif -%}
          {%- if contact_card.settings.heading != blank -%}
            <h2 class="card-heading sub-heading m-0">{{ contact_card.settings.heading }}</h2>
          {%- endif -%}
          {%- if contact_card.settings.text != blank -%}
            <p class="text m-0">{{ contact_card.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
  {%- form 'contact', id: 'ContactForm', class: 'service-form' -%}
    {%- if section.settings.form_heading != blank -%}
      <h1 class="form-heading sub-heading m-0">{{ section.settings.form_heading }}</h1>
    {%- endif -%}
    {%- if form.posted_successfully? -%}
      <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
        {{- 'icon-success.svg' | inline_asset_content -}}
        {{ 'templates.contact.form.post_success' | t }}
      </h2>
    {%- elsif form.errors -%}
      <div class="form__message">
        <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
          {{- 'icon-error.svg' | inline_asset_content -}}
          {{ 'templates.contact.form.error_heading' | t }}
        </h2>
      </div>
      <ul class="form-status-list caption-large" role="list">
        <li>
          <a href="#ContactForm-email" class="link">
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </a>
        </li>
      </ul>
    {%- endif -%}
    {%- assign form_blocks = section.blocks | where: 'type', 'form_item' -%}
    {%- for block in form_blocks -%}
      {%- assign downcase_name = block.settings.field_name | downcase -%}
      {%- if downcase_name == 'email' -%}
        <div class="field field--with-error">
          <input
            autocomplete="email"
            type="email"
            id="ContactForm-email"
            class="field__input"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-email-error"
            {% endif %}
            placeholder="{{ block.settings.placeholder }}"
            {%- if block.settings.required -%}
              required
            {%- endif -%}
          >
          <label class="field__label" for="ContactForm-email">
            {{- 'templates.contact.form.email' | t }}
            <span aria-hidden="true">*</span></label
          >
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="ContactForm-email-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              <span class="form__message">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </span>
            </small>
          {%- endif -%}
        </div>
      {%- elsif block.settings.field_type == 'textarea' -%}
        <div class="field">
          <textarea
            rows="10"
            id="ContactForm-body"
            class="text-area field__input"
            name="contact[{{ block.settings.field_name }}]"
            placeholder="{{ block.settings.placeholder }}"
            {%- if block.settings.required -%}
              required
            {%- endif -%}
          >
            {{- form.body -}}
          </textarea>
          <label class="form__label field__label" for="ContactForm-body">
            {{- block.settings.placeholder -}}
          </label>
        </div>
      {%- elsif block.settings.field_type == 'select' -%}
        <select
          name="contact[{{downcase_name}}]"
          id="ContactForm-{{ downcase_name |  remove: ' '  }}"
          {%- if block.settings.required -%}
            required
          {%- endif -%}
        >
          <option value="" selected disabled>{{ block.settings.placeholder }}</option>
          {%- assign options = block.settings.options | split: '|' -%}
          {%- for option in options -%}
            <option value="{{ option }}">{{ option }}</option>
          {%- endfor -%}
        </select>
      {%- else -%}
        <div class="field">
          <input
            type="{{ block.settings.field_type }}"
            id="ContactForm-{{ downcase_name |  remove: ' '  }}"
            class="field__input"
            autocomplete="{{ block.settings.field_type }}"
            name="contact[{{ downcase_name }}]"
            {%- if block.settings.pattern != blank -%}
              pattern="{{ block.settings.pattern }}"
            {%- endif -%}
            value="{% if form[downcase_name] %}{{ form[downcase_name] }}{% elsif customer %}{{ customer[downcase_name] }}{% endif %}"
            placeholder="{{ block.settings.placeholder }}"
            {%- if block.settings.required -%}
              required
            {%- endif -%}
          >
          <label class="field__label" for="ContactForm-{{ downcase_name }}">{{ block.settings.placeholder }}</label>
        </div>
      {%- endif -%}
    {%- endfor -%}
    {%- if section.settings.show_reCAPTCHA_widget -%}
      <div class="g-recaptcha" data-sitekey="your_site_key"></div>
    {%- endif -%}
    {%- if section.settings.form_text != blank -%}
      <div class="elementor-field-type-acceptance elementor-field-group elementor-column elementor-field-group-field_a7142d1 elementor-col-100">
        <div class="elementor-field-subgroup">
          <span class="elementor-field-option">
            <input
              type="checkbox"
              name="form_fields[field_a7142d1]"
              id="form-field-field_a7142d1"
              class="elementor-field elementor-size-sm  elementor-acceptance-field"
              checked="checked"
            >
            <label for="form-field-field_a7142d1">
              {{ section.settings.form_text }}
            </label>
          </span>
        </div>
      </div>
    {%- endif -%}
    <div class="contact__button">
      <button type="submit" class="button">
        {{ section.settings.submit_button_text }}
      </button>
    </div>
  {%- endform -%}
</div>
{% schema %}
{
  "name": "Service Form",
  "tag": "section",
  "class": "shopify-section--service-form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Form Settings"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form Heading"
    },
    {
      "type": "richtext",
      "id": "form_text",
      "label": "Form Text"
    },
    {
      "type": "text",
      "id": "submit_button_text",
      "label": "Submit Button Text"
    },
    {
      "type": "color",
      "id": "form_bg_color",
      "label": "Background Color",
      "default": "#FFF"
    },
    {
      "type": "color",
      "id": "form_border_color",
      "label": "Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "form_border_width",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "label": "Border Width",
      "default": 1
    },
    {
      "type": "range",
      "id": "form_border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Border Radius",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_reCAPTCHA_widget",
      "label": "Show reCAPTCHA Widget",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_faq",
      "label": "Show Faq",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Faq Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Text"
        }
      ]
    },
    {
      "type": "form_item",
      "name": "Form Item",
      "settings": [
        {
          "type": "text",
          "id": "field_type",
          "label": "Field type"
        },
        {
          "type": "text",
          "id": "field_name",
          "label": "Field Name"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": true
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "PlaceHolder"
        },
        {
          "type": "text",
          "id": "options",
          "label": "Options(only for select)"
        },
        {
          "type": "text",
          "id": "pattern",
          "label": "Pattern"
        }
      ]
    },
    {
      "type": "contact_info_card",
      "name": "Contact Info Card",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "color",
          "id": "image_bg_color",
          "label": "Image Background Color",
          "default": "#000000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Service Form",
      "settings": {}
    }
  ]
}
{% endschema %}
