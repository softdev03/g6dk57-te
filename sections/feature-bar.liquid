{% schema %}
{
  "name": "Feature Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f5f8fc"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bottom Border Color",
      "default": "#ffd700"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size",
      "min": 20,
      "max": 60,
      "step": 5,
      "default": 30,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "feature_icon",
          "label": "Feature Icon"
        },
        {
          "type": "text",
          "id": "feature_text",
          "label": "Feature Text",
          "default": "Feature Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Bar",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "feature_text": "1YR WEBSITE WARRANTY"
          }
        },
        {
          "type": "feature",
          "settings": {
            "feature_text": "20+ INDUSTRY PARTNERSHIPS"
          }
        },
        {
          "type": "feature",
          "settings": {
            "feature_text": "100% AUSTRALIAN"
          }
        },
        {
          "type": "feature",
          "settings": {
            "feature_text": "300+ PROJECTS COMPLETED"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<link rel="stylesheet" href="{{ 'custom-feature.css' | asset_url }}">

<section class="feature-bar">
  <div class="feature-container">
    <div class="feature-item">
      <img src="{{ 'warranty.svg' | asset_url }}" alt="Warranty" width="100%" height="100%">
      <span>1YR WEBSITE WARRANTY</span>
    </div>
    <div class="feature-item">
      <img src="{{ 'star.svg' | asset_url }}" alt="Industry Partnerships" width="100%" height="100%">
      <span>20+ INDUSTRY PARTNERSHIPS</span>
    </div>
    <div class="feature-item">
      <img src="{{ 'australia.svg' | asset_url }}" alt="Australian" width="100%" height="100%">
      <span>100% AUSTRALIAN</span>
    </div>
    <div class="feature-item">
      <img src="{{ 'partners.svg' | asset_url }}" alt="Projects Completed" width="100%" height="100%">
      <span>300+ PROJECTS COMPLETED</span>
    </div>
  </div>
</section>
