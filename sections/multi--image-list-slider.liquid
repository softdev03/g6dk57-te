		},
		{
			"type": "color",
			"id": "slider_arrow_btn_bg_color",
			"label": "Background Color",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "slider_arrow_btn_text_color",
			"label": "Button Text Color",
			"default": "#fff"
		},
		{
			"type": "color",
			"id": "slider_arrow_btn_bg_color_hover",
			"label": "Background Color when Hover",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "slider_arrow_btn_text_color_hover",
