                    }
                  }
                {%- endstyle -%}
              {%- endif -%}
            {%- elsif block.type == 'text_block' -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="heading item-heading m-0">
                  {{ block.settings.heading }}
                </h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="text item-text">{{ block.settings.text }}</div>
              {%- endif -%}
            {%- endif -%}
          </div>
          {%- style -%}
            @media screen and (max-width: 749px) {
              #image-{{ block.id }} {
                order: {{ block.settings.mobile_order }};
              }
            }
          {%- endstyle -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Animation Image Blocks",
  "tag": "section",
  "class": "shopify-section--animation-image-blocks",
  "settings": [
    {
      "type": "checkbox",
      "id": "hero_section",
      "label": "Hero Section",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "second_line_index",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "/",
      "label": "Second Line Index",
      "default": 4
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "image_block",
      "name": "Image Block",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_on_desktop",
          "label": "Show on Desktop",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_on_mobile",
          "label": "Show on Mobile",
          "default": true
        },
        {
          "type": "range",
          "id": "mobile_order",
          "min": 0,
          "max": 50,
          "step": 1,
          "unit": "*",
          "label": "Order no Mobile",
          "default": 0
        },
        {
          "type": "header",
          "content": "Main Image Settings"
        },
        {
          "type": "image_picker",
          "id": "main_image",
          "label": "Main Image"
        },
        {
          "type": "range",
          "id": "top_when_hover",
          "min": -150,
          "max": 150,
          "step": 3,
          "unit": "px",
          "label": "Top when Hover",
          "default": 0
        },
        {
          "type": "range",
          "id": "main_image_z_index",
          "min": -10,
          "max": 10,
          "step": 1,
          "unit": "px",
          "label": "Main Image z Index",
          "default": 0
        },
        {
          "type": "header",
          "content": "Payment App Image Setting"
        },
        {
          "type": "image_picker",
          "id": "payment_app_image",
          "label": "Payment App Image"
        },
        {
          "type": "range",
          "id": "payment_app_image_width_on_desktop",
          "min": 10,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Payment App Image Width on Desktop",
          "default": 100
        },
        {
          "type": "range",
          "id": "payment_app_image_width_on_mobile",
          "min": 10,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Payment App Image Width on Mobile",
          "default": 100
        },
        {
          "type": "range",
          "id": "payment_app_image_pos_as_top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Payment App Image Pos(Top)",
          "default": 0
        },
        {
          "type": "range",
          "id": "start_left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Init Pos(left)",
          "default": 0
        },
        {
          "type": "range",
          "id": "end_left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Target Pos(left)",
          "default": 0
        },
        {
          "type": "range",
          "id": "payment_app_image_pos_when_hover",
          "min": -100,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Payment app Image Pos when Hover",
          "default": 30
        },
        {
          "type": "range",
          "id": "payment_image_z_index",
          "min": -10,
          "max": 10,
          "step": 1,
          "unit": "*",
          "label": "Payment Image z Index",
          "default": 0
        },
        {
          "type": "header",
          "content": "First Circle Image"
        },
        {
          "type": "image_picker",
          "id": "first_circle_image",
          "label": "First Circle Image"
        },
        {
          "type": "range",
          "id": "first_circle_image_width_on_desktop",
          "min": 10,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "First Circle Image Width on Desktop",
          "default": 30
        },
        {
          "type": "range",
          "id": "first_circle_image_width_on_mobile",
          "min": 10,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "First Circle Image Width on Mobile",
          "default": 30
        },
        {
          "type": "number",
          "id": "first_circle_image_init_angle",
          "label": "First Circle Image Init Angle",
          "default": 0
        },
        {
          "type": "number",
          "id": "first_circle_image_target_angle",
          "label": "First Circle Image Target Angle",
          "default": 0
        },
        {
          "type": "range",
          "id": "first_circle_image_desktop_pos_as_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "First Circle Image Pos on Desktop(Left)",
          "default": 0
        },
        {
          "type": "range",
          "id": "first_circle_image_desktop_pos_as_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "First Circle Image Pos on Desktop(Top)",
          "default": 0
        },
        {
          "type": "range",
          "id": "first_circle_image_mobile_pos_as_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "First Circle Image Pos on Mobile on Mobile(Left)",
          "default": 0
        },
        {
          "type": "range",
          "id": "first_circle_image_mobile_pos_as_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "First Circle Image Pos on Mobile(Top)",
          "default": 0
        },
        {
          "type": "range",
          "id": "first_circle_image_z_index",
          "min": -10,
          "max": 10,
          "step": 1,
          "unit": "*",
          "label": "First Circle Image z Index",
          "default": 0
        },
        {
          "type": "checkbox",
          "id": "first_image_effect",
          "label": "First Image Effect when Appear",
          "default": false
        },
        {
          "type": "header",
          "content": "Second Circle Image"
        },
        {
          "type": "image_picker",
          "id": "second_circle_image",
          "label": "Second Circle Image"
        },
        {
          "type": "range",
          "id": "second_circle_image_width_on_desktop",
          "min": 10,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Second Circle Image Width on Desktop",
          "default": 30
        },
        {
          "type": "range",
          "id": "second_circle_image_width_on_mobile",
          "min": 10,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Second Circle Image Width on Mobile",
          "default": 30
        },
        {
          "type": "number",
          "id": "second_circle_image_init_angle",
          "label": "Second Circle Image Init Angle",
          "default": 0
        },
        {
          "type": "number",
          "id": "second_circle_image_target_angle",
          "label": "Second Circle Image Target Angle",
          "default": 0
        },
        {
          "type": "range",
          "id": "second_circle_image_desktop_pos_as_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Second Circle Image Pos on Desktop(Left)",
          "default": 0
        },
        {
          "type": "range",
          "id": "second_circle_image_desktop_pos_as_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Second Circle Image Pos on Desktop(Top)",
          "default": 0
        },
        {
          "type": "range",
          "id": "second_circle_image_mobile_pos_as_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Second Circle Image Pos on Mobile on Mobile(Left)",
          "default": 0
        },
        {
          "type": "range",
          "id": "second_circle_image_mobile_pos_as_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Second Circle Image Pos on Mobile(Top)",
          "default": 0
        },
        {
          "type": "range",
          "id": "second_circle_image_z_index",
          "min": -10,
          "max": 10,
          "step": 1,
          "unit": "*",
          "label": "Second Circle Image z Index",
          "default": 0
        },
        {
          "type": "checkbox",
          "id": "second_image_effect",
          "label": "Second Image Effect when Appear",
          "default": false
        },
        {
          "type": "header",
          "content": "Third Circle Image"
        },
        {
          "type": "image_picker",
          "id": "third_circle_image",
          "label": "Third Circle Image"
        },
        {
          "type": "range",
          "id": "third_circle_image_width_on_desktop",
          "min": 30,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Third Circle Image Width on Desktop",
          "default": 30
        },
