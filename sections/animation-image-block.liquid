{{ 'animation-image-blocks.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
  	padding-top: {{ section.settings.desktop_padding_top }}px;
  	padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
  	#shopify-section-{{ section.id }} {
  		padding-top: {{ section.settings.mobile_padding_top }}px;
  		padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  	}
  }
{%- endstyle -%}
<div class="shopify-section-aib-list page-width">
  {%- if section.settings.heading != blank -%}
    {%- if section.settings.hero_section -%}
      <h1 class="heading m-0">{{ section.settings.heading }}</h1>
    {%- else -%}
      <h2 class="heading m-0">{{ section.settings.heading }}</h2>
    {%- endif -%}
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="animation-image-list desktop">
      {%- for block in section.blocks -%}
        {%- if forloop.first -%}
          <div class="block-sub-list">
        {%- elsif forloop.index == section.settings.second_line_index -%}
          </div>
          <div class="block-sub-list">
        {%- endif -%}
        {%- if block.settings.show_on_desktop -%}
          <div class="block" id="image-{{ block.id }}">
            {%- if block.type == 'image_block' -%}
              {%- if block.settings.main_image != blank -%}
                <div class="image-wrapper">
                  <div class="image">
                    <img src="{{ block.settings.main_image |  img_url: '600x' }}" alt="" width="600px" height="auto">
                  </div>
                  {%- if block.settings.payment_app_image != blank -%}
                    <div
                      class="payment-app-image"
                      style="left: {{ block.settings.start_left }}%"
                      init-pos="{{ block.settings.start_left }}"
                      target-pos="{{ block.settings.end_left }}"
                    >
                      <img src="{{ block.settings.payment_app_image |  img_url: '400x' }}" width="400px" height="auto">
                    </div>
                  {%- endif -%}
                  {%- if block.settings.first_circle_image != blank -%}
                    <div
                      class="first-circle-image circle-image {% if block.settings.first_image_effect %} effect {% endif %}"
                      style="transform: rotate({{ block.settings.first_circle_image_init_angle }}deg)"
                      init-angle="{{ block.settings.first_circle_image_init_angle }}"
                      target-angle="{{ block.settings.first_circle_image_target_angle }}"
                    >
                      <img
                        src="{{ block.settings.first_circle_image |  img_url: '600x' }}"
                        alt=""
                        width="600px"
                        height="auto"
                      >
                    </div>
                  {%- endif -%}
                  {%- if block.settings.second_circle_image != blank -%}
                    <div
                      class="second-circle-image circle-image {% if block.settings.second_image_effect %} effect {% endif %}"
                      style="transform: rotate({{ block.settings.second_circle_image_init_angle }}deg)"
                      init-angle="{{ block.settings.second_circle_image_init_angle }}"
                      target-angle="{{ block.settings.second_circle_image_target_angle }}"
                    >
                      <img
                        src="{{ block.settings.second_circle_image |  img_url: '600x' }}"
                        alt=""
                        width="600px"
                        height="auto"
                      >
                    </div>
                  {%- endif -%}
                  {%- if block.settings.third_circle_image != blank -%}
                    <div
                      class="third-circle-image circle-image {% if block.settings.third_image_effect %} effect {% endif %}"
                      style="transform: rotate({{ block.settings.third_circle_image_init_angle }}deg)"
                      init-angle="{{ block.settings.third_circle_image_init_angle }}"
                      target-angle="{{ block.settings.third_circle_image_target_angle }}"
                    >
                      <img
                        src="{{ block.settings.third_circle_image |  img_url: '600x' }}"
                        alt=""
                        width="600px"
                        height="auto"
                      >
                    </div>
                  {%- endif -%}
                </div>
                {%- style -%}
                  #image-{{ block.id }} .image {
                    z-index: {{ block.settings.main_image_z_index }};
                  }
                  #image-{{ block.id }} .image:hover {
                    top: {{ block.settings.top_when_hover }}px;
                  }
                  #image-{{ block.id }} .payment-app-image {
                    width: {{ block.settings.payment_app_image_width_on_desktop }}px;
                    top: {{ block.settings.payment_app_image_pos_as_top }}%;
                    z-index: {{ block.settings.payment_image_z_index }};
                  }
                  #image-{{ block.id }} .payment-app-image:hover {
                    margin-top: {{ block.settings.payment_app_image_pos_when_hover }}px;
                  }
                  #image-{{ block.id }} .first-circle-image {
                    width: {{ block.settings.first_circle_image_width_on_desktop }}px;
                    left: {{ block.settings.first_circle_image_desktop_pos_as_x }}%;
                    top: {{ block.settings.first_circle_image_desktop_pos_as_y }}%;
                    z-index: {{ block.settings.first_circle_image_z_index }};
                  }
                  #image-{{ block.id }} .second-circle-image {
                    width: {{ block.settings.second_circle_image_width_on_desktop }}px;
                    left: {{ block.settings.second_circle_image_desktop_pos_as_x }}%;
                    top: {{ block.settings.second_circle_image_desktop_pos_as_y }}%;
                    z-index: {{ block.settings.second_circle_image_z_index }};
                  }
                  #image-{{ block.id }} .third-circle-image {
                    width: {{ block.settings.third_circle_image_width_on_desktop }}px;
                    left: {{ block.settings.third_circle_image_desktop_pos_as_x }}%;
                    top: {{ block.settings.third_circle_image_desktop_pos_as_y }}%;
                    z-index: {{ block.settings.third_circle_image_z_index }};
                  }
                  @media screen and (max-width: 749px) {
                    #image-{{ block.id }} .payment-app-image {
                      width: {{ block.settings.payment_app_image_width_on_mobile }}px;
                    }
                    #image-{{ block.id }} .first-circle-image {
                      width: {{ block.settings.first_circle_image_width_on_mobile }}px;
                      left: {{ block.settings.first_circle_image_mobile_pos_as_x }}%;
                      top: {{ block.settings.first_circle_image_mobile_pos_as_y }}%;
                    }
                    #image-{{ block.id }} .second-circle-image {
                      width: {{ block.settings.second_circle_image_width_on_mobile }}px;
                      left: {{ block.settings.second_circle_image_mobile_pos_as_x }}%;
                      top: {{ block.settings.second_circle_image_mobile_pos_as_y }}%;
                    }
                    #image-{{ block.id }} .third-circle-image {
                      width: {{ block.settings.third_circle_image_width_on_mobile }}px;
                      left: {{ block.settings.third_circle_image_mobile_pos_as_x }}%;
                      top: {{ block.settings.third_circle_image_mobile_pos_as_y }}%;
                    }
                  }
                {%- endstyle -%}
              {%- endif -%}
            {%- elsif block.type == 'text_block' -%}
              {%- if block.settings.heading != blank -%}
                <h3 class="heading item-heading m-0">
                  {{ block.settings.heading }}
                </h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="text item-text">{{ block.settings.text }}</div>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    </div>
    <div class="animation-image-list mobile">
      {%- for block in section.blocks -%}
        {%- if block.settings.show_on_mobile -%}
          <div class="block" id="image-{{ block.id }}">
