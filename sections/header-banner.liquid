{% schema %}
  {
    "name": "Header Banner",
    "tag": "header",

    "settings": [
    
   {
        "type": "image_picker",
        "id": "right_banner",
        "label": "Right Banner"
      }, {
        "type": "text",
        "id": "top_banner_left",
        "label": "Top Banner Left Text",
        "default": "Australian Owned and Operated"
      },
    ],

    "presets": [
      {
        "name": "Header Banner",
        "category": "Custom Sections"
      }
    ]
  }
{% endschema %}

{% style %}
  .banner-section{
     background: rgb(253, 211, 23);
  }

.banner-container {
  background: rgb(253, 211, 23);
  display: flex;
  justify-content: space-between;
  align-items: center;
  max-width: 1300px;
  margin: 0 auto;
  width: 100%;
  /* padding: 0 20px;
  padding-top:0px;
  padding-bottom:10px; */
}

.banner-left {
  padding:10px;
  flex: 1;
  text-align: left;
}

.banner-right {
  padding:10px;
  flex: 1;
  text-align: right;
}

.stars {
  width: 120px; /* Adjust the width */
  height: auto; /* Maintain aspect ratio */
  display: inline-block;
  vertical-align: middle;
  margin-left: 5px;
}
@media(max-width: 768px) {
    .banner-left{
      display:none;
    }
  .banner-right{
    text-align:center;
  }
}


{% endstyle %}


<section class="banner-section">
  <div class="banner-container">
    <div class="banner-left">{{ section.settings.top_banner_left }}</div>
    <div class="banner-right">

      Trusted By Businesses
      <img
        src="{{ section.settings.right_banner | image_url }}"
        alt="5 Star Rating"
        class="stars"
        width="100%"
        height="100%">

      <!-- <span class="stars">★★★★★</span> -->
    </div>
  </div>

  
</section>
