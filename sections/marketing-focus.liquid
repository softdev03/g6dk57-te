{% schema %}
{
  "name": "Marketing Focus Section",
  "settings": [
    {
      "type": "text",
      "id": "key",
      "label": "Key"
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "We Know Our Stuff (So you can focus on yours)."
    },
    {
      "type": "textarea",
      "id": "sub_text",
      "label": "Sub Text",
      "default": "Forget becoming a DIY marketer. We'll get it right the first time."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Request a Quote"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Marketing Focus Section",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

<link rel="stylesheet" href="{{ 'marketing-focus.css' | asset_url }}">
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    background: linear-gradient(to right, #f9f9f9, #ffffff);
  }
  @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      }
  }
{%- endstyle -%}
<section class="marketing-focus-section page-width" {% if section.settings.key != blank %} tab key="{{ section.settings.key }}" {% endif %}>
  <div class="marketing-focus-container">
    <!-- Logo -->
    <div class="marketing-logo">

        <img src="{{ section.settings.logo_image |image_url  }}" alt="Marketing Logo">

    </div>
    
    <!-- Text Content -->
    <div class="marketing-text">
      <h2>{{ section.settings.headline }}</h2>
      <p>{{ section.settings.sub_text }}</p>
    </div>
    
    <!-- Button -->
    <div class="marketing-button">
      <a href="{{ section.settings.button_link }}" class="focus-btn">
        {{ section.settings.button_text }} <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>
