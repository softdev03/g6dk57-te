{{ 'overview.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
  	padding-top: {{ section.settings.desktop_padding_top }}px;
  	padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
  	#shopify-section-{{ section.id }} {
  		padding-top: {{ section.settings.mobile_padding_top }}px;
  		padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  	}
  }
{%- endstyle -%}
<div class="shopify-section-overview page-width">
  <div class="text-content">
    {%- if section.settings.heading != blank -%}
      <h1 class="heading m-0">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="text m-0">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
  <div class="image-content">
    {%- if section.settings.left_image != blank -%}
      <div class="left-image lh-0">
        <img src="{{ section.settings.left_image |  img_url: '500x' }}" alt="" width="500px" height="auto">
      </div>
    {%- endif -%}
    {%- if section.settings.right_image != blank -%}
      <div class="right-image lh-0">
        <img src="{{ section.settings.right_image |  img_url: '500x' }}" alt="" width="500px" height="auto">
      </div>
    {%- endif -%}
    {%- if section.settings.clap_hand_result != blank -%}
      <div class="clap-image m-0">
        <img src="{{ section.settings.clap_hand_result |  img_url: '500x' }}" alt="" width="500px" height="auto">
      </div>
    {%- endif -%}
    {%- if section.settings.payment_app != blank -%}
      <div class="payment-app-image m-0">
        <img src="{{ section.settings.payment_app |  img_url: '500x' }}" alt="" width="500px" height="auto">
      </div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Overview",
  "tag": "section",
  "class": "shopify-section--overview",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "left_image",
      "label": "Left Image"
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Image"
    },
    {
      "type": "image_picker",
      "id": "clap_hand_result",
      "label": "Clap Hand Result"
    },
    {
      "type": "image_picker",
      "id": "payment_app",
      "label": "Payment App"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Overview",
      "settings": {}
    }
  ]
}
{% endschema %}
