{{ 'multi--image-list-grid.css' | asset_url | stylesheet_tag }}
{%- assign breakpoints = section.blocks |  where: 'type', 'breakpoint' |  map: 'settings' -%}
{%- style -%}
  #shopify-section-{{ section.id }} {
  	padding-top: {{ section.settings.desktop_padding_top }}px;
  	padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  	background-color: {{ section.settings.bg_color }};
  }
	#shopify-section-{{ section.id }} .image-item {
		border-radius: {{ section.settings.image_item_border_radius }}px;
	}
	#shopify-section-{{ section.id }} .loadmore {
		background-color: {{ section.settings.loadmore_btn_bg_color }};
		color: {{ section.settings.loadmore_btn_text_color }};
		border-radius: {{ section.settings.loadmore_btn_border_radius }}px;
	}
	#shopify-section-{{ section.id }} .loadmore:hover {
		background-color: {{ section.settings.loadmore_btn_bg_color_hover }};
		color: {{ section.settings.loadmore_btn_text_color_hover }};
	}
	{%- for breakpoint in breakpoints -%}
    @media screen and (min-width: {{ breakpoint.min_width }}px) {
      #shopify-section-{{ section.id }} .image-item {
        aspect-ratio: {{ breakpoint.image_aspect_ratio }};
        {%- assign gapCount = breakpoint.item_count |  minus: 1 -%}
        {%- assign gapWidth = gapCount |  times: breakpoint.gap -%}
        width: calc((100% - {{ gapWidth }}px) / {{ breakpoint.item_count }});
      }
      #shopify-section-{{ section.id }} .image-item:hover {
        transition-duration: {{ breakpoint.animation_time }}s;
      }
      #shopify-section-{{ section.id }} .image-grid {
        row-gap: {{ breakpoint.row_gap }}px;
        column-gap: {{ breakpoint.gap }}px;
      }
    }
  {%- endfor -%}
  @media screen and (max-width: 749px) {
  	#shopify-section-{{ section.id }} {
  		padding-top: {{ section.settings.mobile_padding_top }}px;
  		padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  	}
  }
{%- endstyle -%}
<div class="shopify-section-milg page-width">
  {%- assign imageBlocks = section.blocks | where: 'type', 'image_list' |  map: 'settings' -%}
  {%- assign count = 0 -%}
  {%- assign isClosed = true -%}
  {%- for linkItem in imageBlocks -%}
    {%- assign rest = forloop.index |  modulo: section.settings.max_count_per_view -%}
    {% if rest == 1 %}<div class="image-grid {% if count > 0 %} hidden {% endif %}"> {%  assign isClosed = false %}{% endif %}
      {%- if linkItem.image != blank -%}
        {%- if linkItem.link != blank -%}
          <a href="{{ linkItem.link }}" class="swiper-slide image-item" style="background-image: url('{{ linkItem.image |  img_url: '500x' }}');">
          </a>
        {%- else -%}
          <div class="swiper-slide image-item" style="background-image: url('{{ linkItem.image |  img_url: '500x' }}');">
          </div>
        {%- endif -%}
      {%- endif -%}
    {%- if rest == 0 -%}
      </div>
      {%- assign isClosed = true -%}
    {%- endif -%}
    {% if rest == 1 %}
      {%- assign count = count | plus: 1 -%}
    {% endif %}
  {%- endfor -%}
  {%- if isClosed == false -%}
    </div>
    {%- assign count = count |  plus: 1 -%}
  {%- endif -%}
	{%- if section.settings.loadmore_btn_text != blank and count > 1 -%}
		<button class="loadmore">{{ section.settings.loadmore_btn_text }}</button>
	{%- endif -%}
</div>
{% schema %}
{
  "name": "Multi Image List Grid",
  "tag": "section",
  "class": "shopify-section--milg",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fff"
    },
    {
      "type": "range",
      "id": "image_item_border_radius",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Image Item Border Radius",
      "default": 0
    },
		{
			"type": "header",
			"content": "Load More Button Settings"
		},
		{
			"type": "text",
			"id": "loadmore_btn_text",
			"label": "Button Text"
		},
		{
			"type": "color",
			"id": "loadmore_btn_bg_color",
			"label": "Background Color",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "loadmore_btn_text_color",
			"label": "Button Text Color",
			"default": "#fff"
		},
		{
			"type": "color",
			"id": "loadmore_btn_bg_color_hover",
			"label": "Background Color when Hover",
			"default": "#000000"
		},
		{
			"type": "color",
			"id": "loadmore_btn_text_color_hover",
			"label": "Button Text Color when Hover",
			"default": "#fff"
		},
		{
			"type": "range",
			"id": "loadmore_btn_border_radius",
			"min": 0,
			"max": 100,
			"step": 1,
			"unit": "px",
			"label": "Button Border Radius",
			"default": 0
		},
    {
      "type": "range",
      "id": "max_count_per_view",
      "min": 2,
      "max": 30,
      "step": 1,
      "label": "Max Item Count to Show at Once",
      "default": 4
    },
		{
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "image_list",
      "name": "Image List",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "breakpoint",
      "name": "Breakpoint",
      "settings": [
        {
          "type": "number",
          "id": "min_width",
          "label": "Min Width",
          "default": 0
        },
        {
          "type": "range",
          "id": "item_count",
          "min": 1,
          "max": 10,
          "step": 1,
          "label": "Item Count Per Row",
          "default": 5
        },
        {
          "type": "range",
          "id": "gap",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Column Gap",
          "default": 0
        },
        {
          "type": "range",
          "id": "row_gap",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Row Gap",
          "default": 20
        },
        {
          "type": "range",
          "id": "image_aspect_ratio",
          "min": 0.1,
          "max": 3,
          "step": 0.1,
          "label": "Image Aspect Ratio",
          "default": 0.5
        },
        {
          "type": "range",
          "id": "animation_time",
          "min": 0.5,
          "max": 30,
          "step": 0.5,
          "unit": "s",
          "label": "Animation Time",
          "default": 8
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multi Image List Grid",
      "settings": {}
    }
  ]
}
{% endschema %}
