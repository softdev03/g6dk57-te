          "min": -100,
          "max": 100,
          "step": 2,
          "unit": "%",
          "label": "Vertical Pos on Mobile",
          "default": 0
        },
        {
          "type": "header",
          "content": "Move Effect Settings on Desktop"
        },
        {
          "type": "number",
          "id": "desktop_translate_x",
          "label": "Translate X on Desktop",
          "default": 0
