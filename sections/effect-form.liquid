          "min": -100,
          "max": 100,
          "step": 2,
          "unit": "%",
          "label": "Horizontal Pos on Mobile",
          "default": 0
        },
        {
          "type": "range",
          "id": "mobile_pos_y",
          "min": -100,
          "max": 100,
          "step": 2,
          "unit": "%",
          "label": "Vertical Pos on Mobile",
          "default": 0
        },
        {
          "type": "number",
          "id": "init_angle",
          "label": "Init Angle",
          "default": 0
        },
        {
          "type": "number",
          "id": "target_angle",
          "label": "Target Angle",
          "default": 0
        }
      ]
    },
    {
      "type": "payment_app_image",
      "name": "Payment App Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "desktop_width",
          "min": 0,
          "max": 300,
          "step": 3,
          "unit": "px",
          "label": "Image width on Desktop",
          "default": 60
        },
        {
          "type": "range",
          "id": "mobile_width",
          "min": 0,
          "max": 300,
          "step": 3,
          "unit": "px",
          "label": "Image width on Mobile",
          "default": 60
        },
        {
          "type": "range",
          "id": "desktop_pos_x",
          "min": -100,
          "max": 100,
          "step": 2,
          "unit": "%",
          "label": "Horizontal Pos on Desktop",
          "default": 0
        },
        {
          "type": "range",
          "id": "desktop_pos_y",
          "min": -100,
          "max": 100,
          "step": 2,
          "unit": "%",
          "label": "Vertical Pos on Desktop",
          "default": 0
        },
        {
          "type": "range",
