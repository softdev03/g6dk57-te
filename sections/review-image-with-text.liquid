{{ 'review-image-with-text.css' |  asset_url |  stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.desktop_padding_top }}px;
      padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
			background-color: {{ section.settings.bg_color }};
			color: {{ section.settings.text_color }};
  }
  @media screen and (max-width: 749px) {
		#shopify-section-{{ section.id }} {
			padding-top: {{ section.settings.mobile_padding_top }}px;
			padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
		}
  }
{%- endstyle -%}
<div class="shopify-section-riwt page-width">
  {%- if section.settings.text != blank -%}
    <p class="text">{{ section.settings.text }}</p>
  {%- endif -%}
  {%- if section.settings.review_image != blank -%}
    <div class="image">
      <img src="{{ section.settings.review_image|  img_url: '700x' }}" alt="" width="700px" height="auto">
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Review Image with Text",
  "tag": "section",
  "class": "shopify-section--riwt",
  "settings": [
    {
      "type": "image_picker",
      "id": "review_image",
      "label": "Review Image"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Backgorund Color",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Review Image with Text",
      "settings": {}
    }
  ]
}
{% endschema %}
