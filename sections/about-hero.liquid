{{ 'about-hero.css' |  asset_url |  stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
  	padding-top: {{ section.settings.desktop_padding_top }}px;
  	padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
  	#shopify-section-{{ section.id }} {
  		padding-top: {{ section.settings.mobile_padding_top }}px;
  		padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  	}
  }
{%- endstyle -%}
<div class="shopify-section-about-hero page-width">
	<div class="text-content">
		{%- if section.settings.heading != blank -%}
			<h1 class="heading m-0">{{ section.settings.heading }}</h1>
		{%- endif -%}
		{%- if section.settings.text != blank -%}
			<div class="text">{{ section.settings.text }}</div>
		{%- endif -%}
	</div>
	<div class="image-wrapper">
		{%- if section.settings.image != blank -%}
			<div class="image">
				<img src="{{ section.settings.image |  img_url: '800' }}" alt="" width="800px" height="auto">
			</div>
		{%- endif -%}
	</div>
</div>
{% schema %}
{
  "name": "About Hero",
  "tag": "section",
  "class": "shopify-section--about-hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "About Hero",
      "settings": {}
    }
  ]
}
{% endschema %}
