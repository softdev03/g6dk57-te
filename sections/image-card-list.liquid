{{ 'card-list.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  {%- for block in section.blocks -%}
    #card-{{ block.id }} .image-wrapper {
      background-color: {{ block.settings.bg_color }};
      {% if block.settings.show_border == true %}
        border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }}
      {% endif %};
      border-radius: {{ block.settings.border_radius }}px;
    }
    #card-{{ block.id }} .image-wrapper:hover {
      background-color: {{ block.settings.hover_bg_color }};
    }
    #card-{{ block.id }} .image-wrapper:hover .image {
      top: {{ block.settings.top_when_hover }}px;
    }
  {%- endfor -%}
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="shopify-section-image-card-list page-width">
  {%- if section.settings.heading != blank -%}
    <h1 class="heading m-0">{{ section.settings.heading }}</h1>
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="card-list">
      {%- for block in section.blocks -%}
        <div class="card-item" id="card-{{ block.id }}">
          {%- if block.settings.card_image != blank -%}
            {%- if block.settings.card_link != blank -%}
              <a class="image-wrapper" href="{{ block.settings.card_link }}">
                <div class="image">
                  <img src="{{ block.settings.card_image|  img_url: '400x' }}" alt="" width="400px" height="auto">
                </div>
              </a>
            {%- else -%}
              <div class="image-wrapper">
                <div class="image">
                  <img src="{{ block.settings.card_image|  img_url: '400x' }}" alt="" width="400px" height="auto">
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}
          <div class="text-content">
            {%- if block.settings.heading != blank -%}
              <h2 class="card-heading m-0">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="card-text m-0">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Image Card List",
  "tag": "section",
  "class": "shopify-seciton--image-card-list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Card Image"
        },
        {
          "type": "url",
          "id": "card_link",
          "label": "Card Link"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background Color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "hover_bg_color",
          "label": "Background Color when Hover",
          "default": "#000000"
        },
        {
          "type": "checkbox",
          "id": "show_border",
          "label": "Show Border",
          "default": true
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Border Color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "border_width",
          "min": 0,
          "max": 10,
          "step": 1,
          "unit": "px",
          "label": "Border Width",
          "default": 1
        },
        {
          "type": "range",
          "id": "border_radius",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Border Radius",
          "default": 0
        },
        {
          "type": "range",
          "id": "top_when_hover",
          "min": -100,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "Top when Hover",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Card List",
      "settings": {}
    }
  ]
}
{% endschema %}
