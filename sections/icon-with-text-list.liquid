{{ 'icon-with-text-list.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    border-block: 1px solid {{ section.settings.border_color |  default : 'transparent' }};
    background-color: {{ section.settings.bg_color }};
  }
  {%- assign gap = section.settings.item_count_on_desktop |  minus: 1 |  times: 20 -%}
  #shopify-section-{{ section.id }} .icon-with-text-item {
    width: calc((100% - {{ gap }}px) / {{ section.settings.item_count_on_desktop }});
    font-size: {{ section.settings.desktop_font_size }}px;
  }
  @media screen and (max-width: 1023px) {
    {%- assign gap = section.settings.item_count_on_tablet |  minus: 1 |  times: 20 -%}
    #shopify-section-{{ section.id }} .icon-with-text-item {
      width: calc((100% - {{ gap }}px) / {{ section.settings.item_count_on_tablet }});
      font-size: {{ section.settings.tablet_font_size }}px;
    }
  }
  @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      }
  }
  @media screen and (max-width: 512px) {
    {%- assign gap = section.settings.item_count_on_mobile |  minus: 1 |  times: 20 -%}
    #shopify-section-{{ section.id }} .icon-with-text-item {
      width: calc((100% - {{ gap }}px) / {{ section.settings.item_count_on_mobile }});
      font-size: {{ section.settings.mobile_font_size }}px;
    }
  }
{%- endstyle -%}
<div class="shopify-section-iwt-list page-width {% if section.settings.show_on_desktop %} desktop {% endif %} {% if section.settings.show_on_mobile %} mobile {% endif %}">
  {%- if section.settings.heading != blank -%}
    <h1 class="heading">{{ section.settings.heading }}</h1>
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="icon-with-text-list">
      {%- for block in section.blocks -%}
        <div class="icon-with-text-item">
          {%- if block.settings.icon != blank -%}
            <div class="icon">
              <img src="{{ block.settings.icon |  img_url: '50x' }}" alt="" width="50px" height="auto">
            </div>
          {%- endif -%}
          <div class="text-content">
            {%- if block.settings.heading != blank -%}
              <h2 class="item-heading">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="item-text">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.button_link != blank and block.settings.button_text != blank -%}
              <a href="{{ block.settings.button_link }}" class="item-link">{{ block.settings.button_text }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
  {%- if section.settings.button_link != blank and section.settings.button_text != blank -%}
    <a href="{{ section.settings.button_link }}" class="button button--primary">{{ section.settings.button_text }}</a>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Icon with Text List",
  "tag": "section",
  "class": "shopify-section--iwt-list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "item_count_on_desktop",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "*",
      "label": "Item Count on Desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "item_count_on_tablet",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "*",
      "label": "Item Count on Tablet",
      "default": 3
    },
    {
      "type": "range",
      "id": "item_count_on_mobile",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "*",
      "label": "Item Count on Mobile",
      "default": 4
    },
    {
      "type": "range",
      "id": "desktop_font_size",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop Font Size",
      "default": 20
    },
    {
      "type": "range",
      "id": "tablet_font_size",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Tablet Font Size",
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Font Size",
      "default": 16
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on Desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on Mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "icon-with-text",
      "name": "Icon with Text",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon with Text List",
      "settings": {}
    }
  ]
}
{% endschema %}
