{{ 'menu-list.css' | asset_url |  stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
		color: {{ section.settings.text_color }};
  }
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{%- endstyle -%}
<div class="shopify-section-menu-list page-width">
    {%- if section.blocks.size > 0 -%}
			<div class="desktop-menu">
				{%- for block in section.blocks -%}
					<div class="menu-item">
						{%- if block.settings.heading != blank -%}
							<h3 class="menu-heading">{{ block.settings.heading }}</h3>
							{%- if block.settings.menu != blank -%}
								<div class="menu">
									{%- for link in block.settings.menu.links -%}
										<a href="{{ link.url }}" class="menu-link">{{ link.title }}</a>
									{%- endfor -%}
								</div>
							{%- endif -%}
						{%- endif -%}
					</div>
				{%- endfor -%}
			</div>
			<div class="mobile-menu">
				{%- for block in section.blocks -%}
					<div class="accordion" type="group" container="#shopify-section-{{ section.id }}">
						<h3 class="menu-heading accordion-heading">
							{{ block.settings.heading }}{{ 'icon-close.svg' | inline_asset_content }}
						</h3>
						<div class="menu accordion-content">
							{%- for link in block.settings.menu.links -%}
								<a href="{{ link.url }}" class="menu-link">{{ link.title }}</a>
							{%- endfor -%}
						</div>
					</div>
				{%- endfor -%}
			</div>
    {%- endif -%}
</div>
{% schema %}
{
  "name": "Menu List",
  "tag": "section",
  "class": "shopify-section--menu-list",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFF"
    },
		{
			"type": "color",
			"id": "text_color",
			"label": "Text Color",
			"default": "#000000"
		},
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "menu_item",
      "name": "Menu Item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Menu List",
      "settings": {}
    }
  ]
}
{% endschema %}
