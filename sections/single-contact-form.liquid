{{ 'single-contact-form.css' |  asset_url |  stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
  #shopify-section-{{ section.id }} {
  	padding-top: {{ section.settings.mobile_padding_top }}px;
  	padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }
  }
{%- endstyle -%}
<div class="shopify-section-sscf page-width" {% if section.settings.section_id != blank %} id="{{ section.settings.section_id }}" {% endif %}>
	{%- assign form_id = section.id | append: '-single-contact-form' -%}
  {%- render 'single-contact-form', form_settings: section.settings,id: form_id,hide_open_area: true -%}
</div>
{% schema %}
