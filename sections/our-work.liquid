{{ 'our-work.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  	background-color: {{ section.settings.bg_color }};
  }
	#shopify-section-{{ section.id }} .card-item {
		{%  assign rgb = section.settings.card_box_shadow_color |  color_to_rgb |  remove: 'rgb(' |  remove: ')'   %}
		border-radius: {{ section.settings.card_border_radius }}px;
		background-color: {{ section.settings.card_bg_color }};
		box-shadow: 0px 0px 12px 0px rgba({{ rgb }}, 0.14);
		color: {{ section.settings.card_text_color }};
	}
	#shopify-section-{{ section.id }} .card-link {
		background-color: {{ section.settings.card_button_bg_color }};
		color: {{ section.settings.card_button_text_color }};
	}
	#shopify-section-{{ section.id }} .card-link:hover {
		background-color: {{ section.settings.card_button_bg_color_hover }};
		color: {{ section.settings.card_button_text_color_hover }};
	}
  #shopify-section-{{ section.id }} .filter-items {
    {%- assign rgb = section.settings.filter_box_shadow_color |  color_to_rgb |  remove: 'rgb(' | remove: ')' -%}
    box-shadow: 0px 0px 66px 0px rgba({{ rgb }}, 0.14);
    background-color: {{ section.settings.filter_bg_color }};
    border-radius: {{ section.settings.filter_border_radius }}px;
  }
  #shopify-section-{{ section.id }} .filter-sub-heading {
    color: {{ section.settings.filter_sub_heading_color }};
  }
  #shopify-section-{{ section.id }} .filter-list:not(:last-child) {
    border-color: {{ section.settings.filter_split_border_color }};
  }
  #shopify-section-{{ section.id }} .filter-item {
    color: {{ section.settings.filter_item_color }};
    background-color: {{ section.settings.filter_item_bg_color }};
    border: 1px solid {{ section.settings.filter_item_border_color }};
    border-radius: {{ section.settings.filter_item_border_radius }}px;
  }
  #shopify-section-{{ section.id }} .filter-item:hover {
    color: {{ section.settings.filter_item_color_hover }};
    background-color: {{ section.settings.filter_item_bg_color_hover }};
    border-color: {{ section.settings.filter_item_border_color_hover }};
  }
  #shopify-section-{{ section.id }} .filter-item.selected {
    color: {{ section.settings.filter_item_color_selected }};
    background-color: {{ section.settings.filter_item_bg_color_selected }};
    border-color: {{ section.settings.filter_item_border_color_selected }};
  }
  #shopify-section-{{ section.id }} .banner {
    background-color: {{ section.settings.banner_bg_color }};
    border-radius: {{ section.settings.banner_border_radius }}px;
    color: {{ section.settings.banner_text_color }};
    {%- assign rgb = section.settings.banner_box_shadow_color |  color_to_rgb |  remove: 'rgb(' |  remove: ')' -%}
    box-shadow: 0px 0px 66px 0px rgba({{ rgb }}, 0.14);
  }
  #shopify-section-{{ section.id }} .banner-link {
    background-color: {{ section.settings.banner_button_bg_color }};
    color: {{ section.settings.banner_button_text_color }};
    border-radius: {{ section.settings.banner_button_border_radius }}px;
  }
  #shopify-section-{{ section.id }} .banner-link:hover {
    background-color: {{ section.settings.banner_button_bg_color_hover }};
    color: {{ section.settings.banner_button_text_color_hover }};
  }
  @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      }
  }
{%- endstyle -%}
<div class="shopify-section-our-work page-width">
	{% if section.settings.heading != blank %}
		<h1 class="heading" style="color: {{ section.settings.heading_color }}">{{ section.settings.heading }}</h1>
	{% endif %}
	{% if section.settings.description != blank %}
		<p class="description" style="color: {{ section.settings.description_color }}">{{ section.settings.description }}</p>
	{% endif %}
	<div class="main-content">
		<div class="card-list">
			{%- assign cards = section.blocks |  where: 'type', 'card' -%}
			{%- for block in cards -%}
				<div class="card-item" industry="{{ block.settings.industry_keyword }}" service="{{ block.settings.service_keyword }}">
					{%- if block.settings.card_image != blank -%}
						<a class="image" href="{{ block.settings.card_button_link }}">
							<img src="{{ block.settings.card_image |  img_url: '750x' }}" alt="" width="500px" height="auto">
						</a>
					{%- endif -%}
					<div class="card-text-content">
						{%- if block.settings.heading != blank -%}
							<h2 class="card-heading">{{ block.settings.heading }}</h2>
						{%- endif -%}
						{%- if block.settings.description != blank -%}
							<p class="card-description">{{ block.settings.description }}</p>
						{%- endif -%}
					</div>
					{%- if block.settings.card_button_link != blank and block.settings.card_button_text != blank -%}
						<a href="{{ block.settings.card_button_link }}" class="card-link">{{ block.settings.card_button_text }} {{ 'icon-right-arrow.svg' | inline_asset_content }}</a>
					{%- endif -%}
				</div>
			{%- endfor -%}
		</div>
		<div class="filter-and-banner">
			<div class="filter-items">
				<h2 class="filter-heading" style="color: {{ section.settings.filter_heading_color |  default : '#000' }}">{{ section.settings.filter_heading }}</h2>
				{%- assign filterBlocks = section.blocks |  where: 'type', 'filter_item' |  map: 'settings' -%}
				{%- assign industryBlocks = filterBlocks |  where : 'type' , 'industry' -%}
				{%- assign serviceBlocks = filterBlocks |  where : 'type' , 'service' -%}
				{%- if industryBlocks.size > 0 -%}
					<div class="filter-list">
						<h3 class="filter-sub-heading">{{ section.settings.filter_sub_heading1 }}</h3>
						{%- for block in industryBlocks -%}
							<div class="filter-item {% if block.all_items %} all-items selected {% endif %}" keyword="{{ block.keyword }}" type="{{ block.type }}">
								<span>{{ block.label }}</span>
								<div class="icon">
									<img src="{{ section.settings.filter_item_image |  img_url: '40x' }}" alt="" width="40px" height="auto">
									<img src="{{ section.settings.filter_item_selected_image |  img_url: '40x' }}" alt="" width="40px" height="auto">
								</div>
							</div>
						{%- endfor -%}
					</div>
				{%- endif -%}
				{%- if serviceBlocks.size > 0 -%}
					<div class="filter-list">
						<h3 class="filter-sub-heading">{{ section.settings.filter_sub_heading2 }}</h3>
						{%- for block in serviceBlocks -%}
							<div class="filter-item {% if block.all_items %} all-items selected {% endif %}" keyword="{{ block.keyword }}" type="{{ block.type }}">
								<span>{{ block.label }}</span>
								<div class="icon">
									<img src="{{ section.settings.filter_item_image |  img_url: '40x' }}" alt="" width="40px" height="auto">
									<img src="{{ section.settings.filter_item_selected_image |  img_url: '40x' }}" alt="" width="40px" height="auto">
								</div>
							</div>
						{%- endfor -%}
					</div>
				{%- endif -%}
			</div>
			<div class="banner">
				{%- if section.settings.banner_heading != blank -%}
					<h2 class="banner-heading">{{ section.settings.banner_heading }}</h2>
				{%- endif -%}
				{%- if section.settings.banner_image != blank -%}
					<div class="image">
						<img src="{{ section.settings.banner_image |  img_url: '400x' }}" alt="" width="400px" height="auto">
					</div>
				{%- endif -%}
				{%- if section.settings.banner_description != blank -%}
					<p class="banner-description">{{ section.settings.banner_description }}</p>
				{%- endif -%}
				{%- if section.settings.banner_button_link != blank and section.settings.banner_button_text != blank -%}
					<a href="{{ section.settings.banner_button_link }}" class="banner-link">{{ section.settings.banner_button_text }}</a>
				{%- endif -%}
				{%- if section.settings.banner_secondary_description != blank -%}
					<p class="banner-secondary-description">{{ section.settings.banner_secondary_description }}</p>
				{%- endif -%}
			</div>
		</div>
	</div>
</div>
