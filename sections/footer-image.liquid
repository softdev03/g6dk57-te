{{ 'footer-image.css' | asset_url | stylesheet_tag }}
{% style %}
   #shopify-section-{{ section.id }} {
     padding-top: {{ section.settings.desktop_padding_top }}px;
     padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
     background-color: {{ section.settings.section_bg_color }};
   }
   @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
  }
{% endstyle %}
<section
  class="promo-cards-section page-width"
>
  <div class="promo-cards-container">
    {% for block in section.blocks %}
      {% if block.type == 'card' %}
        <div class="promo-card" {{ block.shopify_attributes }}>
          {% if block.settings.card_image %}
            <div class="promo-card-image">
              <img
                src="{{ block.settings.card_image | img_url: '600x' }}"
                alt="{{ block.settings.card_title | escape }}"
              >
            </div>
            <div class="promo-card-content">
              {% if block.settings.card_cta_text != blank %}
                <a
                  href="{{ block.settings.card_cta_link | escape }}"
                  class="promo-card-cta"
                >
                  {{ block.settings.card_cta_text }}
                  <span class="arrow">→</span>
                </a>
                </div>
              {% endif %}
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
  <!-- </div> -->
</section>
{% schema %}
{
  "name": "Promo Cards Section",
  "settings": [
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#FFD000"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Promo Card",
      "settings": [
        {
          "type": "text",
          "id": "card_cta_text",
          "label": "CTA Text",
          "default": "Explore Our Marketing Services For Tradies"
        },
        {
          "type": "url",
          "id": "card_cta_link",
          "label": "CTA Link"
        },
        {
          "type": "image_picker",
          "id": "card_image",
          "label": "Card Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo Cards Section",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
