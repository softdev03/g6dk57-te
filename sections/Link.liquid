{{ 'link.css' |  asset_url |  stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
  	padding-top: {{ section.settings.desktop_padding_top }}px;
  	padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    background-color: {{ section.settings.section_bg_color }};
  }
  #shopify-section-{{ section.id }} .shopify-section-link {
    background-color: {{ section.settings.padding_box_bg_color }};
  }
  #shopify-section-{{ section.id }} .link {
    color: {{ section.settings.text_color }};
    background-color: {{ section.settings.bg_color }};
    border: 1px solid {{ section.settings.border_color }};
    border-radius: {{ section.settings.desktop_border_radius }}px;
  }
  #shopify-section-{{ section.id }} .link:hover {
    color: {{ section.settings.hover_text_color }};
    background-color: {{ section.settings.hover_bg_color }};
    border: 1px solid {{ section.settings.hover_border_color }};
  }
  @media screen and (max-width: 749px) {
  	#shopify-section-{{ section.id }} {
  		padding-top: {{ section.settings.mobile_padding_top }}px;
  		padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  	}
    #shopify-section-{{ section.id }} .link {
      border-radius: {{ section.settings.mobile_border_radius }}px;
    }
  }
{%- endstyle -%}
<div class="shopify-section-link page-width">
  {%- if section.settings.link != blank and section.settings.link_text != blank -%}
    <a href="{{ section.settings.link }}" class="link desktop-{{ section.settings.desktop_align }} mobile-{{ section.settings.mobile_align }}">{{ section.settings.link_text }}</a>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "Link",
  "tag": "section",
  "class": "shpoify-section--link",
  "settings": [
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "hover_bg_color",
      "label": "Background Color when Hover",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "hover_text_color",
      "label": "Text Color when Hover",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "hover_border_color",
      "label": "Border Color when Hover",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "padding_box_bg_color",
      "label": "Padding Box Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "desktop_border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop Border Radius",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile Border Radius",
      "default": 0
    },
    {
      "type": "select",
      "id": "desktop_align",
      "label": "Desktop Align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_align",
      "label": "Mobile Align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Link",
      "settings": {}
    }
  ]
}
{% endschema %}
