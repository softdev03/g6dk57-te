{{ 'about-card-list.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.desktop_padding_top }}px;
      padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} {
          padding-top: {{ section.settings.mobile_padding_top }}px;
          padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      }
  }
{%- endstyle -%}
<div class="shopify-section-about-card-list page-width">
  {%- if section.settings.heading != blank -%}
    <h1 class="heading m-0">{{ section.settings.heading }}</h1>
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="card-list">
      {%- for block in section.blocks -%}
        <div class="card-item" style="background-color: {{ block.settings.bg_color }}; color:{{ block.settings.text_color }}; border: 2px solid {{ block.settings.border_color }}">
          {%- if block.settings.image != blank -%}
            <div class="image-wrapper">
              <div class="image">
                <img src="{{ block.settings.image |  img_url: '200x' }}" alt="" width="200px" height="auto">
              </div>
            </div>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="card-heading sub-heading m-0">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="text m-0">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
{% schema %}
{
  "name": "About Card List",
  "tag": "section",
  "class": "shopify-section--about-card-list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name":"Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background Color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "Border Color",
          "default": "#000000"
        },
      ]
    }
  ],
  "presets": [
    {
      "name": "About Card List",
      "settings": {}
    }
  ]
}
{% endschema %}
