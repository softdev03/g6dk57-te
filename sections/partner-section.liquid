{% schema %}
{
  "name": "Partner Section",
  "settings": [
    {
      "type": "text",
      "id": "partner_title",
      "label": "Title",
      "default": "Partnered With"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fff"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Partner Section",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}

<link rel="stylesheet" href="{{ 'partner-section.css' | asset_url }}">
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
  }
  @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      }
  }
{%- endstyle -%}
<section class="partner-section page-width">
  <div class="partner-wrapper">
    <div class="partner-title">{{ section.settings.partner_title }}</div>
    <div class="partner-container">
      {%- for block in section.blocks -%}
        <div class="partner-logo">
          <img src="{{ block.settings.logo | image_url }}" alt="Logo">
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
