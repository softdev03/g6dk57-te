{{ 'image-with-text-list.css' | asset_url | stylesheet_tag }}
{%- style -%}
  #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.desktop_padding_top }}px;
      padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} {
          padding-top: {{ section.settings.mobile_padding_top }}px;
          padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      }
  }
{%- endstyle -%}
<div class="shopify-sectin-iwt-list page-width">
  {%- if section.settings.hero_section -%}
    <h1 class="heading m-0">
      {%- if section.settings.heading != blank -%}
        {{ section.settings.heading }}
      {%- else -%}
        Heading
      {%- endif -%}
    </h1>
  {%- else -%}
    <h2 class="heading m-0">
      {%- if section.settings.heading != blank -%}
        {{ section.settings.heading }}
      {%- else -%}
        Heading
      {%- endif -%}
    </h2>
  {%- endif -%}
  <div class="text">
    {%- if section.settings.text != blank -%}
      {{ section.settings.text }}
    {%- else -%}
      Text
    {%- endif -%}
  </div>
  <div class="image-with-text-list">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="iwt-item">
          {%- if block.settings.image != blank -%}
            <div class="image lh-0">
              <img src="{{ block.settings.image |  img_url: '500x' }}" alt="" width="500px" height="auto">
            </div>
            {%- if block.settings.heading != blank -%}
              <h2 class="sub-heading m-0">{{ block.settings.heading }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="text item-text">{{ block.settings.text }}</div>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..3) -%}
        <div class="iwt-item">
          <div class="image lh-0">
            {{ 'img.svg' | inline_asset_content }}
          </div>
          <h3 class="sub-heading m-0">Heading-{{ i }}</h3>
          <div class="text item-text">Text-{{ i }}</div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Image with Text List",
  "tag": "section",
  "class": "shopify-section--image-with-text-list",
  "settings": [
    {
      "type": "checkbox",
      "id": "hero_section",
      "label": "Hero Section",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "image_with_text_item",
      "name": "Image with Text Item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with Text List",
      "settings": {}
    }
  ]
}
{% endschema %}
