{% schema %}
{
  "name": "Custom Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "marketing_image",
      "label": "Marketing Image"
    },
    {
      "type": "url",
      "id": "marketing_link",
      "label": "Marketing Link"
    },
    {
      "type": "image_picker",
      "id": "website_image",
      "label": "Website Image"
    },
    {
      "type": "url",
      "id": "website_link",
      "label": "Website Link"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Logo"
    },
    {
      "type": "image_picker",
      "id": "proudly_owned",
      "label": "Proudly Australian Owned"
    },
    {
      "type": "url",
      "id": "request_call_link",
      "label": "Request Call Link"
    }
  ],
  "presets": [
    {
      "name": "Custom Footer",
      "category": "Footer"
    }
  ]
}
{% endschema %}

<link rel="stylesheet" href="{{ 'footer-new.css' | asset_url }}">

<footer class="custom-footer">

  <!-- Top Yellow Background Section -->
  <div class="footer-top">
    <div class="footer-content">
      
      <div class="marketing-links">
        <div class="footer-card">
          <img src="{{ 'Marketing-for-Aussie-Tradies.png' | asset_url }}" alt="Marketing for Tradies">
          <a href="{{ section.settings.marketing_link }}" class="footer-btn">Explore Our Marketing Services For Tradies →</a>
        </div>
  
        <div class="footer-card">
          <img src="{{ 'Websites-For-Tradies.png' | asset_url }}" alt="Websites for Tradies">
          
       
          <a href="{{ section.settings.website_link }}" class="footer-btn">Explore Our Website Services For Tradies →</a>
        </div>
      </div>

      <div class="footer-bottom-section">
        <div class="footer-logo">
          <a href="/">
            <img src="{{ 'tradiemate-au.svg' | asset_url }}" alt="Tradiemate Logo">
          </a>
          <p>We help Tradies Get Online, Drive More Sales, & Charge Better Rates for their services. Trust the tradie marketing and web design experts, contact Tradiemate today.</p>
        </div>

         <div class="footer-badge">
          <div class="footer-badge-content">
    
            <div class="footer-owned">
              <img src="{{ 'Proudly-Australian-Owned.png' | asset_url }}" alt="Proudly Australian Owned">
            </div>
          </div>
           <div class="footer-owned">
              <a href="{{ section.settings.request_call_link }}" class="footer-black-btn">Request a Call →</a>
           </div>
          </div>

      </div>

    

    </div>
  </div>

  <!-- Divider -->
  <hr class="footer-divider">

  <!-- Footer Navigation Links -->
  <div class="footer-links">
    <div class="footer-column">
      <h3>Popular Services</h3>
      <ul>
        <li><a href="#">Websites</a></li>
        <li><a href="#">Marketing</a></li>
        <li><a href="#">B2B Services</a></li>
        <li><a href="#">Job Leads</a></li>
      </ul>
    </div>

    <div class="footer-column">
      <h3>Paid Ads</h3>
      <ul>
        <li><a href="#">Google Ads</a></li>
        <li><a href="#">Facebook Ads</a></li>
        <li><a href="#">Instagram Ads</a></li>
        <li><a href="#">YouTube Ads</a></li>
      </ul>
    </div>

    <div class="footer-column">
      <h3>Organic Services</h3>
      <ul>
        <li><a href="#">SEO</a></li>
        <li><a href="#">Google My Business</a></li>
        <li><a href="#">Content Writing</a></li>
        <li><a href="#">Email Marketing</a></li>
      </ul>
    </div>

    <div class="footer-column">
      <h3>Design Services</h3>
      <ul>
        <li><a href="#">Branding</a></li>
        <li><a href="#">Capability Statements</a></li>
        <li><a href="#">Logo Design</a></li>
      </ul>
    </div>

    <div class="footer-column">
      <h3>Trades</h3>
      <ul>
        <li><a href="#">Electricians</a></li>
        <li><a href="#">Pest Control</a></li>
        <li><a href="#">Carpenters</a></li>
        <li><a href="#">Cleaning</a></li>
      </ul>
    </div>

    <div class="footer-column">
      <h3>About</h3>
      <ul>
        <li><a href="#">About Tradiemate</a></li>
        <li><a href="#">Our Work</a></li>
        <li><a href="#">Free Content</a></li>
        <li><a href="#">Contact Us</a></li>
      </ul>
    </div>
  </div>

  <!-- Footer Bottom -->
  <div class="footer-bottom">
    <p>All Content © Tradiemate 2024 | Proudly Australian Owned and Operated | <a href="#">Privacy Policy</a></p>
  </div>

</footer>
