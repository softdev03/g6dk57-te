{%- style -%}
  #shopify-section-{{ section.id }} {
  	padding-top: {{ section.settings.desktop_padding_top }}px;
  	padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
  }
  @media screen and (max-width: 749px) {
  	#shopify-section-{{ section.id }} {
  		padding-top: {{ section.settings.mobile_padding_top }}px;
  		padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  	}
  }
{%- endstyle -%}
<div class="shopify-section-footer page-width">
	<div class="footer-main">
		<div class="logo-wrapper">
			<div class="logo">
				{%- if section.settings.logo != blank -%}
					<img src="{{ section.settings.logo |  img_url: '100x' }}" alt="" width="100px" height="auto">
				{%- else -%}
					<img src="{{ settings.logo |  img_url: '100x' }}" alt="" width="100px" height="auto">
				{%- endif -%}
			</div>
			{%- if section.settings.footer_text != blank -%}
				<p class="text m-0">{{ section.settings.footer_text }}</p>
			{%- endif -%}
		</div>
		{%- if section.blocks.size > 0 -%}
			{%- for block in section.blocks -%}
				{%- if block.settings.heading != blank and block.settings.menu != blank -%}
					<div class="menu-item">
						<h1 class="heading">{{ block.settings.heading }}</h1>
						<ul class="menu-item-list">
							{%- for link in block.settings.menu.links -%}
								<li>
									<a href="{{ link.url }}">{{ link.title }}</a>
								</li>
							{%- endfor -%}
						</ul>
					</div>
				{%- endif -%}
			{%- endfor -%}
		{%- endif -%}
	</div>
	<div class="footer-bottom">
		{%- if section.settings.bottom_text != blank -%}
			<p class="bottom-text m-0">{{ section.settings.bottom_text }}</p>
		{%- endif -%}
		{%- if section.settings.show_social_icons == true -%}
			{%- render 'social-icons', class: 'footer__list-social' -%}
		{%- endif -%}
	</div>
</div>
{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "shopify-section--footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "footer_text",
      "label": "Footer Text"
    },
    {
      "type": "text",
      "id": "bottom_text",
      "label": "Bottom Text"
    },
		{
			"type": "checkbox",
			"id": "show_social_icons",
			"label": "Show Social Icons",
			"default": true
		},
    {
      "type": "header",
      "content": "Padding Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "menu_item",
			"name": "Menu Item",
			"limit": 3,
			"settings": [
				{
					"type": "text",
					"id": "heading",
					"label": "Heading"
				},
				{
					"type": "link_list",
					"id": "men",
					"label": "Menu"
				},
			]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "settings": {}
    }
  ]
}
{% endschema %}
