<div
  class="form-step-section check-form {% if block.settings.is_required %} required {% endif %} {% if block.settings.final_step %} final {% endif %}"
  id="form-part-{{ block.id }}"
  index="{{ index }}"
>
  {%- if block.settings.heading != blank -%}
    <h1 class="part-heading" style="color: {{ block.settings.heading_color }}">{{ block.settings.heading }}</h1>
  {%- endif -%}
  {%- if block.settings.description != blank -%}
    <p class="part-description" style="color: {{ block.settings.description_color }}">{{ block.settings.description }}</p>
  {%- endif -%}
  {%- assign fieldItems = block.settings.field_items | split: '|' -%}
  <div class="field-items">
		{%- assign rgb = block.settings.box_shadow_color | color_to_rgb |  remove: 'rgb(' |  remove: ')'   -%}
    {%- for fieldItem in fieldItems -%}
      {%- assign removed_item = fieldItem |  remove: ':'  -%}
      <div class="check-field {% if removed_item != fieldItem %} unique {% endif %}">
        <span></span>
        <input type="hidden" name="contact[{{ block.settings.field_name }}" />
        <label for="field-{{ block.id }}-{{ forloop.index }}" style="color: {{ block.settings.field_items_color }}">
          {{- removed_item -}}
        </label>
      </div>
    {%- endfor -%}
  </div>
  <p class="error-msg" style="color: {{ block.settings.error_msg_color }}">{{ block.settings.error_msg }}</p>
  {%- style -%}
    #form-part-{{ block.id }} .check-field {
    	border: 1px solid {{ block.settings.field_border_color }};
			background-color: {{ block.settings.field_items_bg_color |  default : 'white' }};
			box-shadow: rgba({{ rgb }}, 0.5) 2px 2px 12px 2px;
    }
		#form-part-{{ block.id }} .check-field:hover {
			box-shadow: rgba({{ rgb }}, 0.7) -3px -3px 12px 2px;
		}
    #form-part-{{ block.id }} .check-field:has(span.selected) {
    	border-color: {{ block.settings.selected_field_border_color }};
			position: relative;
			z-index: 1;
    }
    #form-part-{{ block.id }} .check-field:first-child {
    	border-top-left-radius: {{ block.settings.border_radius }}px;
    	border-top-right-radius: {{ block.settings.border_radius }}px;
    }
    #form-part-{{ block.id }} .check-field:last-child {
    	border-bottom-left-radius: {{ block.settings.border_radius }}px;
    	border-bottom-right-radius: {{ block.settings.border_radius }}px;
    }
		#form-part-{{ block.id }} .check-field span {
			border-color: {{ block.settings.selected_field_border_color }};
		}
		#form-part-{{ block.id }} .check-field span.selected {
			background-color: {{ block.settings.selected_field_border_color }};
		}
  {%- endstyle -%}
</div>
